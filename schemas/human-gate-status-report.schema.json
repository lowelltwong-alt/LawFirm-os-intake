{
  "$defs": {
    "HumanGateStatus": {
      "additionalProperties": false,
      "properties": {
        "gate_id": {
          "enum": [
            "human_intake_confirmation",
            "human_conflicts_clearance",
            "human_engagement_authorization",
            "human_budget_review",
            "human_carrier_preapproval",
            "human_matter_opening_authorization"
          ],
          "title": "Gate Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "required": {
          "const": true,
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "completed",
            "pending"
          ],
          "title": "Status",
          "type": "string"
        },
        "authority_owner": {
          "title": "Authority Owner",
          "type": "string"
        },
        "completed_by_human": {
          "title": "Completed By Human",
          "type": "boolean"
        },
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "structured_refs": {
          "items": {
            "type": "string"
          },
          "title": "Structured Refs",
          "type": "array"
        },
        "blocks": {
          "items": {
            "type": "string"
          },
          "title": "Blocks",
          "type": "array"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        }
      },
      "required": [
        "gate_id",
        "label",
        "status",
        "authority_owner",
        "completed_by_human"
      ],
      "title": "HumanGateStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "human_gate_status_report_id": {
      "title": "Human Gate Status Report Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "preflight_packet_id": {
      "title": "Preflight Packet Id",
      "type": "string"
    },
    "confirmation_id": {
      "title": "Confirmation Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending_human_gates",
        "all_human_gates_complete"
      ],
      "title": "Status",
      "type": "string"
    },
    "required_gate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Required Gate Ids",
      "type": "array"
    },
    "completed_gate_count": {
      "minimum": 0,
      "title": "Completed Gate Count",
      "type": "integer"
    },
    "pending_gate_count": {
      "minimum": 0,
      "title": "Pending Gate Count",
      "type": "integer"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/HumanGateStatus"
      },
      "title": "Gates",
      "type": "array"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "human_gate_status_report_id",
    "run_id",
    "preflight_packet_id",
    "confirmation_id",
    "status",
    "required_gate_ids",
    "completed_gate_count",
    "pending_gate_count",
    "gates",
    "generated_at"
  ],
  "title": "HumanGateStatusReport",
  "type": "object"
}
