{
  "$defs": {
    "EvidenceGraphEdge": {
      "additionalProperties": false,
      "properties": {
        "edge_id": {
          "title": "Edge Id",
          "type": "string"
        },
        "source_node_id": {
          "title": "Source Node Id",
          "type": "string"
        },
        "relationship": {
          "title": "Relationship",
          "type": "string"
        },
        "target_node_id": {
          "title": "Target Node Id",
          "type": "string"
        },
        "status": {
          "default": "candidate",
          "title": "Status",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "edge_id",
        "source_node_id",
        "relationship",
        "target_node_id"
      ],
      "title": "EvidenceGraphEdge",
      "type": "object"
    },
    "EvidenceGraphNode": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "title": "Node Id",
          "type": "string"
        },
        "node_type": {
          "title": "Node Type",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "attributes": {
          "additionalProperties": true,
          "title": "Attributes",
          "type": "object"
        }
      },
      "required": [
        "node_id",
        "node_type",
        "status"
      ],
      "title": "EvidenceGraphNode",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "segment_id",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "graph_id": {
      "title": "Graph Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/EvidenceGraphNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/EvidenceGraphEdge"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "graph_id",
    "nodes",
    "edges"
  ],
  "title": "EvidenceGraph",
  "type": "object"
}
