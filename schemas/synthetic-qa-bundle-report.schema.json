      "type": "boolean"
    },
    "not_authorized_for_external_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For External Write",
      "type": "boolean"
    },
    "not_authorized_for_lake_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Lake Write",
      "type": "boolean"
    },
    "not_authorized_for_sqlite_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Sqlite Write",
      "type": "boolean"
    },
    "not_authorized_for_budget_submission": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Budget Submission",
      "type": "boolean"
    },
    "not_authorized_for_matter_opening": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Matter Opening",
      "type": "boolean"
    },
    "fixture_files_mutated": {
      "const": false,
      "default": false,
      "title": "Fixture Files Mutated",
      "type": "boolean"
    },
    "calibration_applied": {
      "const": false,
      "default": false,
      "title": "Calibration Applied",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "budget_submission_performed": {
      "const": false,
      "default": false,
      "title": "Budget Submission Performed",
      "type": "boolean"
    },
    "matter_opening_performed": {
      "const": false,
      "default": false,
      "title": "Matter Opening Performed",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "synthetic_qa_bundle_report_id",
    "status",
    "run_root_ref",
    "out_dir_ref",
    "artifact_count",
    "required_artifact_count",
    "missing_required_artifact_count",
    "blocked_artifact_count",
    "pending_artifact_count",
    "failed_artifact_count",
    "artifacts",
    "required_next_actions",
    "generated_at"
