{
  "$defs": {
    "SyntheticQABundleArtifact": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "present": {
          "title": "Present",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "passed",
            "pending_review",
            "blocked",
            "failed",
            "missing"
          ],
          "title": "Status",
          "type": "string"
        },
        "gate_state": {
          "enum": [
            "passed",
            "pending_review",
            "blocked",
            "failed",
            "missing"
          ],
          "title": "Gate State",
          "type": "string"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        },
        "copied_to_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Copied To Ref"
        },
        "source_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Sha256"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "artifact_id",
        "label",
        "file_name",
        "required",
        "present",
        "status",
        "gate_state"
      ],
      "title": "SyntheticQABundleArtifact",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "synthetic_qa_bundle_report_id": {
      "title": "Synthetic Qa Bundle Report Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "pending_review",
        "blocked",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "run_root_ref": {
      "title": "Run Root Ref",
      "type": "string"
    },
    "out_dir_ref": {
      "title": "Out Dir Ref",
      "type": "string"
    },
    "artifact_count": {
      "minimum": 0,
      "title": "Artifact Count",
      "type": "integer"
    },
    "required_artifact_count": {
      "minimum": 0,
      "title": "Required Artifact Count",
      "type": "integer"
    },
    "missing_required_artifact_count": {
      "minimum": 0,
      "title": "Missing Required Artifact Count",
      "type": "integer"
    },
    "blocked_artifact_count": {
      "minimum": 0,
      "title": "Blocked Artifact Count",
      "type": "integer"
    },
    "pending_artifact_count": {
      "minimum": 0,
      "title": "Pending Artifact Count",
      "type": "integer"
    },
    "failed_artifact_count": {
      "minimum": 0,
      "title": "Failed Artifact Count",
      "type": "integer"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/SyntheticQABundleArtifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "ui_manifest_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
