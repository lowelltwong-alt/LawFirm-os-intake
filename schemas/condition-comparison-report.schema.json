{
  "$defs": {
    "ConditionComparisonCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "offending_refs": {
          "items": {
            "type": "string"
          },
          "title": "Offending Refs",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "ConditionComparisonCheck",
      "type": "object"
    },
    "ConditionPairDelta": {
      "additionalProperties": false,
      "description": "Whether two conditions agreed on a case. Agreement is not correctness.",
      "properties": {
        "case_ref": {
          "title": "Case Ref",
          "type": "string"
        },
        "left_condition_id": {
          "title": "Left Condition Id",
          "type": "string"
        },
        "right_condition_id": {
          "title": "Right Condition Id",
          "type": "string"
        },
        "outcomes_identical": {
          "title": "Outcomes Identical",
          "type": "boolean"
        },
        "left_projection_digest": {
          "title": "Left Projection Digest",
          "type": "string"
        },
        "right_projection_digest": {
          "title": "Right Projection Digest",
          "type": "string"
        }
      },
      "required": [
        "case_ref",
        "left_condition_id",
        "right_condition_id",
        "outcomes_identical",
        "left_projection_digest",
        "right_projection_digest"
      ],
      "title": "ConditionPairDelta",
      "type": "object"
    },
    "ConditionRunRecord": {
      "additionalProperties": false,
      "description": "The outcome of one condition on one case. The comparative unit.",
      "properties": {
        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "record_id": {
          "title": "Record Id",
          "type": "string"
        },
        "case_ref": {
          "title": "Case Ref",
          "type": "string"
        },
        "case_digest": {
          "title": "Case Digest",
          "type": "string"
        },
        "partition": {
          "enum": [
            "development",
            "holdout"
          ],
          "title": "Partition",
          "type": "string"
        },
        "condition_id": {
          "title": "Condition Id",
          "type": "string"
        },
        "config_digest": {
          "title": "Config Digest",
          "type": "string"
        },
        "status": {
          "enum": [
            "completed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "outcome_projection_digest": {
          "title": "Outcome Projection Digest",
          "type": "string"
        },
        "model_calls_permitted": {
          "minimum": 0,
          "title": "Model Calls Permitted",
          "type": "integer"
        },
        "provider_call_performed": {
          "const": false,
          "default": false,
          "title": "Provider Call Performed",
          "type": "boolean"
        },
        "run_dir_ref": {
          "title": "Run Dir Ref",
          "type": "string"
        },
        "failure_reason": {
          "default": "",
          "title": "Failure Reason",
          "type": "string"
        },
        "data_scope": {
          "const": "synthetic_only",
          "default": "synthetic_only",
          "title": "Data Scope",
          "type": "string"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        }
      },
      "required": [
        "record_id",
        "case_ref",
        "case_digest",
        "partition",
        "condition_id",
        "config_digest",
        "status",
        "outcome_projection_digest",
        "model_calls_permitted",
        "run_dir_ref"
      ],
      "title": "ConditionRunRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "split_id": {
      "title": "Split Id",
      "type": "string"
    },
    "split_manifest_ref": {
      "title": "Split Manifest Ref",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "scored_partition": {
      "enum": [
        "development",
        "holdout"
      ],
      "title": "Scored Partition",
      "type": "string"
    },
    "condition_ids": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Condition Ids",
      "type": "array"
    },
    "case_count": {
      "minimum": 0,
      "title": "Case Count",
      "type": "integer"
    },
    "completed_run_count": {
      "minimum": 0,
      "title": "Completed Run Count",
      "type": "integer"
    },
    "failed_run_count": {
      "minimum": 0,
      "title": "Failed Run Count",
      "type": "integer"
    },
    "max_model_calls_permitted": {
      "minimum": 0,
      "title": "Max Model Calls Permitted",
      "type": "integer"
    },
    "provider_calls_performed": {
      "default": 0,
      "minimum": 0,
      "title": "Provider Calls Performed",
      "type": "integer"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/ConditionRunRecord"
      },
      "title": "Records",
      "type": "array"
    },
    "pair_deltas": {
      "items": {
        "$ref": "#/$defs/ConditionPairDelta"
      },
      "title": "Pair Deltas",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ConditionComparisonCheck"
      },
      "minItems": 1,
      "title": "Checks",
      "type": "array"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "comparative_claim_supported": {
      "title": "Comparative Claim Supported",
      "type": "boolean"
    },
    "comparative_claim_note": {
      "title": "Comparative Claim Note",
      "type": "string"
    },
    "required_next_gates": {
      "items": {
        "type": "string"
      },
      "title": "Required Next Gates",
      "type": "array"
    },
    "data_scope": {
      "const": "synthetic_only",
      "default": "synthetic_only",
      "title": "Data Scope",
      "type": "string"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "human_review_required": {
      "const": true,
      "default": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    }
  },
  "required": [
    "report_id",
    "split_id",
    "split_manifest_ref",
    "generated_at",
    "scored_partition",
    "condition_ids",
    "case_count",
    "completed_run_count",
    "failed_run_count",
    "max_model_calls_permitted",
    "checks",
    "status",
    "comparative_claim_supported",
    "comparative_claim_note"
  ],
  "title": "ConditionComparisonReport",
  "type": "object"
}
