        },
        "failed_items": {
          "items": {
            "$ref": "#/$defs/LearningOwnerHandoffItem"
          },
          "title": "Failed Items",
          "type": "array"
        },
        "blocked_items": {
          "items": {
            "$ref": "#/$defs/LearningOwnerHandoffItem"
          },
