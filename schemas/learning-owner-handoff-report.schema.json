          "type": "array"
        },
        "required_owner_review_scope": {
          "items": {
            "type": "string"
          },
          "title": "Required Owner Review Scope",
          "type": "array"
        },
        "required_next_gates": {
          "items": {
            "type": "string"
          },
          "title": "Required Next Gates",
          "type": "array"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        },
        "human_review_required": {
          "const": true,
          "default": true,
          "title": "Human Review Required",
          "type": "boolean"
        },
        "owning_repo_review_required": {
          "const": true,
          "default": true,
          "title": "Owning Repo Review Required",
          "type": "boolean"
        },
        "promotion_authorized": {
          "const": false,
          "default": false,
          "title": "Promotion Authorized",
          "type": "boolean"
        },
        "proposed_changes_applied": {
          "const": false,
          "default": false,
          "title": "Proposed Changes Applied",
          "type": "boolean"
        },
        "baseline_mutated": {
          "const": false,
          "default": false,
          "title": "Baseline Mutated",
          "type": "boolean"
        },
        "lake_write_performed": {
          "const": false,
          "default": false,
          "title": "Lake Write Performed",
          "type": "boolean"
        },
        "sqlite_write_performed": {
          "const": false,
          "default": false,
          "title": "Sqlite Write Performed",
          "type": "boolean"
        },
        "external_writes_performed": {
          "const": false,
          "default": false,
          "title": "External Writes Performed",
          "type": "boolean"
        },
        "silent_learning_performed": {
          "const": false,
          "default": false,
          "title": "Silent Learning Performed",
          "type": "boolean"
        }
      },
      "required": [
        "owner_handoff_package_id",
        "target_owner",
        "source_shadow_eval_result_report_id",
        "status",
        "item_count",
        "passed_candidate_count",
        "failed_candidate_count",
        "blocked_candidate_count",
        "ready_items",
        "failed_items",
        "blocked_items",
        "required_owner_review_scope",
        "required_next_gates"
      ],
      "title": "LearningOwnerHandoffPackage",
      "type": "object"
    }
