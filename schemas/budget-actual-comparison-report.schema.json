{
  "$defs": {
    "BudgetActualPhaseComparison": {
      "additionalProperties": false,
      "properties": {
        "phase_id": {
          "title": "Phase Id",
          "type": "string"
        },
        "budgeted_fees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budgeted Fees"
        },
        "budgeted_expenses": {
          "default": 0,
          "title": "Budgeted Expenses",
          "type": "number"
        },
        "budgeted_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budgeted Total"
        },
        "actual_fees": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Fees"
        },
        "actual_expenses": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Expenses"
        },
        "actual_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Total"
        },
        "variance_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variance Amount"
        },
        "variance_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Variance Percent"
        },
        "status": {
          "enum": [
            "actuals_not_available",
            "within_threshold",
            "over_threshold",
            "under_threshold"
          ],
          "title": "Status",
          "type": "string"
        },
        "external_code_candidates": {
          "items": {
            "type": "string"
          },
          "title": "External Code Candidates",
          "type": "array"
        },
        "requires_human_review": {
          "default": true,
          "title": "Requires Human Review",
          "type": "boolean"
        }
      },
      "required": [
        "phase_id",
        "status"
      ],
      "title": "BudgetActualPhaseComparison",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "budget_actual_comparison_report_id": {
      "title": "Budget Actual Comparison Report Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "preflight_packet_id": {
      "title": "Preflight Packet Id",
      "type": "string"
    },
    "budget_proposal_id": {
      "title": "Budget Proposal Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "actuals_not_available",
        "passed",
        "variance_review_required"
      ],
      "title": "Status",
      "type": "string"
    },
    "comparison_scope": {
      "const": "phase",
      "default": "phase",
      "title": "Comparison Scope",
      "type": "string"
    },
    "phase_comparisons": {
      "items": {
        "$ref": "#/$defs/BudgetActualPhaseComparison"
      },
      "title": "Phase Comparisons",
      "type": "array"
    },
    "variance_threshold_percent": {
      "minimum": 0,
      "title": "Variance Threshold Percent",
      "type": "number"
    },
    "total_budgeted": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Budgeted"
    },
    "total_actual": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Actual"
    },
    "total_variance_amount": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Variance Amount"
    },
    "total_variance_percent": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Total Variance Percent"
    },
    "actuals_source_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Actuals Source Ref"
    },
    "actuals_are_synthetic": {
      "default": true,
      "title": "Actuals Are Synthetic",
      "type": "boolean"
    },
    "billing_connector_read_performed": {
      "const": false,
      "default": false,
      "title": "Billing Connector Read Performed",
      "type": "boolean"
    },
    "billing_connector_write_performed": {
      "const": false,
      "default": false,
      "title": "Billing Connector Write Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "budget_actual_comparison_report_id",
    "run_id",
    "preflight_packet_id",
    "budget_proposal_id",
    "status",
    "phase_comparisons",
    "variance_threshold_percent",
    "generated_at"
  ],
  "title": "BudgetActualComparisonReport",
  "type": "object"
}
