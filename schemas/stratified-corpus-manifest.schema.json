{
  "$defs": {
    "StratifiedManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "case_id": {
          "title": "Case Id",
          "type": "string"
        },
        "subtype": {
          "title": "Subtype",
          "type": "string"
        },
        "difficulty": {
          "enum": [
            "clear",
            "moderate",
            "hard"
          ],
          "title": "Difficulty",
          "type": "string"
        },
        "holdout_split": {
          "enum": [
            "train",
            "holdout"
          ],
          "title": "Holdout Split",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        }
      },
      "required": [
        "case_id",
        "subtype",
        "difficulty",
        "holdout_split",
        "plan_id"
      ],
      "title": "StratifiedManifestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Frozen manifest for the driver-stratified corpus, recomputed fail-closed.",
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "corpus_id": {
      "title": "Corpus Id",
      "type": "string"
    },
    "generator_version": {
      "title": "Generator Version",
      "type": "string"
    },
    "corpus_seed": {
      "minimum": 0,
      "title": "Corpus Seed",
      "type": "integer"
    },
    "contract_digest": {
      "title": "Contract Digest",
      "type": "string"
    },
    "case_count": {
      "exclusiveMinimum": 0,
      "title": "Case Count",
      "type": "integer"
    },
    "subtype_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Subtype Counts",
      "type": "object"
    },
    "difficulty_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Difficulty Counts",
      "type": "object"
    },
    "train_count": {
      "minimum": 0,
      "title": "Train Count",
      "type": "integer"
    },
    "holdout_count": {
      "minimum": 0,
      "title": "Holdout Count",
      "type": "integer"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/StratifiedManifestEntry"
      },
      "title": "Cases",
      "type": "array"
    },
    "corpus_digest": {
      "title": "Corpus Digest",
      "type": "string"
    },
    "holdout_split_digest": {
      "title": "Holdout Split Digest",
      "type": "string"
    }
  },
  "required": [
    "corpus_id",
    "generator_version",
    "corpus_seed",
    "contract_digest",
    "case_count",
    "subtype_counts",
    "difficulty_counts",
    "train_count",
    "holdout_count",
    "cases",
    "corpus_digest",
    "holdout_split_digest"
  ],
  "title": "StratifiedCorpusManifest",
  "type": "object"
}
