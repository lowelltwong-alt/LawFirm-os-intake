        "scenario_sensitive": {
          "default": false,
          "title": "Scenario Sensitive",
          "type": "boolean"
        },
        "settlement_administration_phase": {
          "default": false,
          "title": "Settlement Administration Phase",
          "type": "boolean"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        },
        "budget_amount_output_authorized": {
          "const": false,
          "default": false,
          "title": "Budget Amount Output Authorized",
          "type": "boolean"
        }
