    "preflight_packet_id",
    "budget_proposal_id",
    "status",
    "expected_response_count",
    "reconciled_response_count",
    "missing_response_count",
    "unlinked_notice_count",
    "duplicate_notice_count",
    "parser_failure_count",
    "appeal_result_count",
    "remediation_cases",
    "exception_lake_candidates",
    "generated_at"
