            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity"
        },
        "occurrence_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
