        "disputed_amount": {
          "default": 0,
          "minimum": 0,
          "title": "Disputed Amount",
          "type": "number"
        },
        "current_financial_exposure": {
          "default": 0,
          "minimum": 0,
          "title": "Current Financial Exposure",
          "type": "number"
        },
        "human_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
