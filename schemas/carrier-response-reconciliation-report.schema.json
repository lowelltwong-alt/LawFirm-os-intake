        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "candidate_id": {
          "title": "Candidate Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "preflight_packet_id": {
          "title": "Preflight Packet Id",
          "type": "string"
        },
        "local_event_label": {
          "title": "Local Event Label",
          "type": "string"
        },
        "canonical_lake_class": {
          "enum": [
            "retrieval_miss",
            "workflow_escalation",
            "authority_conflict_override"
          ],
