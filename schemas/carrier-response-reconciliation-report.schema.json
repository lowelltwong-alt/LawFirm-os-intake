      "minimum": 0,
      "title": "Missing Response Count",
      "type": "integer"
    },
    "unlinked_notice_count": {
      "minimum": 0,
      "title": "Unlinked Notice Count",
      "type": "integer"
    },
    "duplicate_notice_count": {
      "minimum": 0,
      "title": "Duplicate Notice Count",
      "type": "integer"
    },
    "parser_failure_count": {
      "minimum": 0,
      "title": "Parser Failure Count",
      "type": "integer"
