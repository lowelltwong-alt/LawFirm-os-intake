{
  "$defs": {
    "OCGProposedRuleKind": {
      "additionalProperties": false,
      "description": "One rule kind the vertical needs that the current OCG IR does not yet express.",
      "properties": {
        "proposed_kind": {
          "enum": [
            "task_hour_allowance",
            "ordered_attribution",
            "applicability_envelope"
          ],
          "title": "Proposed Kind",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "nearest_existing_family": {
          "title": "Nearest Existing Family",
          "type": "string"
        },
        "requires_substrate_extension": {
          "default": true,
          "title": "Requires Substrate Extension",
          "type": "boolean"
        },
        "candidate_local_marker": {
          "title": "Candidate Local Marker",
          "type": "string"
        }
      },
      "required": [
        "proposed_kind",
        "rationale",
        "nearest_existing_family",
        "candidate_local_marker"
      ],
      "title": "OCGProposedRuleKind",
      "type": "object"
    },
    "OCGRuleKindExtensionProposal": {
      "additionalProperties": false,
      "description": "Candidate executable extension proposal to the Substrate-owned OCG rule IR.\n\nIntake proposes rule kinds and keeps a local adapter + fixtures; it authors no\ncanonical rule IDs and owns no canonical taxonomy. Substrate-owner review is\nrequired before any promotion.",
      "properties": {
        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "source_owner_required": {
          "default": "LawFirm-os-semantic-substrate",
          "title": "Source Owner Required",
          "type": "string"
        },
        "proposed_kinds": {
          "items": {
            "$ref": "#/$defs/OCGProposedRuleKind"
          },
          "title": "Proposed Kinds",
          "type": "array"
        },
        "local_adapter_ref": {
          "title": "Local Adapter Ref",
          "type": "string"
        },
        "authors_no_canonical_ids": {
          "const": true,
          "default": true,
          "title": "Authors No Canonical Ids",
          "type": "boolean"
        },
        "requires_substrate_owner_review": {
          "const": true,
          "default": true,
          "title": "Requires Substrate Owner Review",
          "type": "boolean"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        }
      },
      "required": [
        "proposal_id",
        "local_adapter_ref"
      ],
      "title": "OCGRuleKindExtensionProposal",
      "type": "object"
    },
    "SiblingConformanceReport": {
      "additionalProperties": false,
      "description": "Read-only conformance of the sibling billing-guideline-simulator vs CW1 outputs.",
      "properties": {
        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "sibling_repo_ref": {
          "title": "Sibling Repo Ref",
          "type": "string"
        },
        "sibling_available": {
          "title": "Sibling Available",
          "type": "boolean"
        },
        "status": {
          "enum": [
            "passed",
            "divergences_found",
            "blocked_sibling_unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "checked_cw1_output_refs": {
          "items": {
            "type": "string"
          },
          "title": "Checked Cw1 Output Refs",
          "type": "array"
        },
        "divergences": {
          "items": {
            "type": "string"
          },
          "title": "Divergences",
          "type": "array"
        },
        "recorded_reason": {
          "title": "Recorded Reason",
          "type": "string"
        },
        "read_only": {
          "const": true,
          "default": true,
          "title": "Read Only",
          "type": "boolean"
        },
        "sibling_is_read_only_challenger": {
          "const": true,
          "default": true,
          "title": "Sibling Is Read Only Challenger",
          "type": "boolean"
        }
      },
      "required": [
        "sibling_repo_ref",
        "sibling_available",
        "status",
        "recorded_reason"
      ],
      "title": "SiblingConformanceReport",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "extension_proposal": {
      "$ref": "#/$defs/OCGRuleKindExtensionProposal"
    },
    "adapter_rule_ir_id": {
      "title": "Adapter Rule Ir Id",
      "type": "string"
    },
    "adapter_canonical_rule_id_violation_count": {
      "minimum": 0,
      "title": "Adapter Canonical Rule Id Violation Count",
      "type": "integer"
    },
    "adapter_source_owner_violation_count": {
      "minimum": 0,
      "title": "Adapter Source Owner Violation Count",
      "type": "integer"
    },
    "adapter_blocker_count": {
      "minimum": 0,
      "title": "Adapter Blocker Count",
      "type": "integer"
    },
    "sibling_conformance": {
      "$ref": "#/$defs/SiblingConformanceReport"
    },
    "requires_substrate_owner_review": {
      "const": true,
      "default": true,
      "title": "Requires Substrate Owner Review",
      "type": "boolean"
    },
    "data_scope": {
      "const": "synthetic_only",
      "default": "synthetic_only",
      "title": "Data Scope",
      "type": "string"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "extension_proposal",
    "adapter_rule_ir_id",
    "adapter_canonical_rule_id_violation_count",
    "adapter_source_owner_violation_count",
    "adapter_blocker_count",
    "sibling_conformance",
    "generated_at"
  ],
  "title": "OCGContractReconciliationReport",
  "type": "object"
}
