{
  "$defs": {
    "BudgetHumanReviewDecisionTemplate": {
      "additionalProperties": false,
      "properties": {
        "template_id": {
          "title": "Template Id",
          "type": "string"
        },
        "review_area": {
          "enum": [
            "budget_revision",
            "actual_variance",
            "carrier_rejection",
            "appeal_result",
            "lake_handoff",
            "learning_loop",
            "authority_boundary",
            "overall"
          ],
          "title": "Review Area",
          "type": "string"
        },
        "source_recommendation_ids": {
          "items": {
            "type": "string"
          },
          "title": "Source Recommendation Ids",
          "type": "array"
        },
        "allowed_outcomes": {
          "items": {
            "enum": [
              "confirm",
              "correct",
              "unknown",
              "needs_more_information",
              "human_only",
              "declined_referred",
              "no_change",
              "appeal",
              "write_off",
              "reopen",
              "block",
              "route_to_owner_review",
              "no_learning_change"
            ],
            "type": "string"
          },
          "title": "Allowed Outcomes",
          "type": "array"
        },
        "recommended_outcome": {
          "enum": [
            "confirm",
            "correct",
            "unknown",
            "needs_more_information",
            "human_only",
            "declined_referred",
            "no_change",
            "appeal",
            "write_off",
            "reopen",
            "block",
            "route_to_owner_review",
            "no_learning_change"
          ],
          "title": "Recommended Outcome",
          "type": "string"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "mutation_policy": {
          "const": "append_or_supersede_only",
          "default": "append_or_supersede_only",
          "title": "Mutation Policy",
          "type": "string"
        },
        "external_submission_authorized": {
          "const": false,
          "default": false,
          "title": "External Submission Authorized",
          "type": "boolean"
        },
        "lake_write_authorized": {
          "const": false,
          "default": false,
          "title": "Lake Write Authorized",
          "type": "boolean"
        },
        "silent_learning_allowed": {
          "const": false,
          "default": false,
          "title": "Silent Learning Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "template_id",
        "review_area",
        "allowed_outcomes",
        "recommended_outcome",
        "required_fields"
      ],
      "title": "BudgetHumanReviewDecisionTemplate",
      "type": "object"
    },
    "BudgetHumanReviewPacketCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "blocking_refs": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Refs",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "BudgetHumanReviewPacketCheck",
      "type": "object"
    },
    "BudgetHumanReviewRecommendation": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "review_area": {
          "enum": [
            "budget_revision",
            "actual_variance",
            "carrier_rejection",
            "appeal_result",
            "lake_handoff",
            "learning_loop",
            "authority_boundary",
            "overall"
          ],
          "title": "Review Area",
          "type": "string"
        },
        "recommended_action": {
          "enum": [
            "confirm_no_change",
            "correct_budget",
            "request_more_information",
            "appeal",
            "accept_write_down",
            "reopen",
            "block_submission",
            "human_only",
            "route_to_owner_review",
            "no_learning_change"
          ],
          "title": "Recommended Action",
          "type": "string"
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "why": {
          "items": {
            "type": "string"
          },
          "title": "Why",
          "type": "array"
        },
        "source_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Artifact Refs",
          "type": "array"
        },
        "required_human_decisions": {
          "items": {
            "type": "string"
          },
          "title": "Required Human Decisions",
          "type": "array"
        },
        "proposed_next_actions": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Next Actions",
          "type": "array"
        },
        "financial_impact": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Financial Impact"
        },
        "candidate_record_families": {
          "items": {
            "enum": [
              "budget_human_change_record",
              "budget_actual_variance_record",
              "budget_actual_missing_source_record",
              "carrier_rejection_decision_record",
              "carrier_appeal_result_record",
              "carrier_financial_outcome_record"
            ],
            "type": "string"
          },
          "title": "Candidate Record Families",
          "type": "array"
        }
      },
      "required": [
        "recommendation_id",
        "review_area",
        "recommended_action",
        "priority",
        "why"
      ],
      "title": "BudgetHumanReviewRecommendation",
      "type": "object"
    },
    "BudgetHumanReviewRedTeamNote": {
      "additionalProperties": false,
      "properties": {
        "note_id": {
          "title": "Note Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "scope": {
          "enum": [
            "proposed_vs_compliant_collapse",
            "duplicate_rejection",
            "scenario_variance_mismatch",
            "source_coverage",
            "authority_boundary",
            "learning_loop_mutation",
            "financial_math",
            "actuals_coverage",
            "lake_handoff"
          ],
          "title": "Scope",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recommended_check": {
          "title": "Recommended Check",
          "type": "string"
        },
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "note_id",
        "severity",
        "scope",
        "message",
        "recommended_check"
      ],
      "title": "BudgetHumanReviewRedTeamNote",
      "type": "object"
    },
    "BudgetLifecycleFinancialSummary": {
      "additionalProperties": false,
      "properties": {
        "original_budget_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Budget Total"
        },
        "human_revision_total_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Revision Total Delta"
        },
        "human_revised_candidate_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Revised Candidate Total"
        },
        "actual_comparison_budgeted_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Comparison Budgeted Total"
        },
        "actual_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Total"
        },
        "actual_variance_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Variance Amount"
        },
        "carrier_disputed_amount": {
          "default": 0,
          "minimum": 0,
          "title": "Carrier Disputed Amount",
          "type": "number"
        },
        "carrier_recovered_amount": {
          "default": 0,
          "minimum": 0,
          "title": "Carrier Recovered Amount",
          "type": "number"
        },
        "carrier_write_down_amount": {
          "default": 0,
          "minimum": 0,
          "title": "Carrier Write Down Amount",
          "type": "number"
        }
      },
      "title": "BudgetLifecycleFinancialSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "budget_human_review_packet_id": {
      "title": "Budget Human Review Packet Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready_for_human_budget_review",
        "blocked_by_lifecycle_audit"
      ],
      "title": "Status",
      "type": "string"
    },
    "source_budget_lifecycle_audit_report_id": {
      "title": "Source Budget Lifecycle Audit Report Id",
      "type": "string"
    },
    "source_budget_lifecycle_audit_report_ref": {
      "title": "Source Budget Lifecycle Audit Report Ref",
      "type": "string"
    },
    "source_budget_lifecycle_audit_status": {
      "enum": [
        "ready_for_budget_lifecycle_review",
        "blocked_missing_lifecycle_artifacts",
        "blocked_inconsistent_lifecycle_evidence"
      ],
      "title": "Source Budget Lifecycle Audit Status",
      "type": "string"
    },
    "source_budget_revision_report_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Budget Revision Report Ref"
    },
    "source_budget_actual_comparison_report_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Budget Actual Comparison Report Ref"
    },
    "source_carrier_rejection_review_packet_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Carrier Rejection Review Packet Ref"
    },
    "source_carrier_rejection_learning_report_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Carrier Rejection Learning Report Ref"
    },
    "budget_proposal_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Proposal Id"
    },
    "preflight_packet_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preflight Packet Id"
    },
    "run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Run Ids",
      "type": "array"
    },
    "financial_summary": {
      "$ref": "#/$defs/BudgetLifecycleFinancialSummary"
    },
    "pending_human_decision_count": {
      "minimum": 0,
      "title": "Pending Human Decision Count",
      "type": "integer"
    },
    "required_human_decisions": {
      "items": {
        "type": "string"
      },
      "title": "Required Human Decisions",
      "type": "array"
    },
    "proposed_next_actions": {
      "items": {
        "type": "string"
      },
      "title": "Proposed Next Actions",
      "type": "array"
    },
    "candidate_record_families": {
      "items": {
        "enum": [
          "budget_human_change_record",
          "budget_actual_variance_record",
          "budget_actual_missing_source_record",
          "carrier_rejection_decision_record",
          "carrier_appeal_result_record",
          "carrier_financial_outcome_record"
        ],
        "type": "string"
      },
      "title": "Candidate Record Families",
      "type": "array"
    },
    "local_event_labels": {
      "items": {
        "type": "string"
      },
      "title": "Local Event Labels",
      "type": "array"
    },
    "required_review_sections": {
      "items": {
        "enum": [
          "budget_revision",
          "actual_variance",
          "carrier_rejection",
          "appeal_result",
          "lake_handoff",
          "learning_loop",
          "authority_boundary",
          "overall"
        ],
        "type": "string"
      },
      "title": "Required Review Sections",
      "type": "array"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/BudgetHumanReviewRecommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "red_team_notes": {
      "items": {
        "$ref": "#/$defs/BudgetHumanReviewRedTeamNote"
      },
      "title": "Red Team Notes",
      "type": "array"
    },
    "decision_templates": {
      "items": {
        "$ref": "#/$defs/BudgetHumanReviewDecisionTemplate"
      },
      "title": "Decision Templates",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/BudgetHumanReviewPacketCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "required_next_gates": {
      "items": {
        "type": "string"
      },
      "title": "Required Next Gates",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "append_only_decision_required": {
      "const": true,
      "default": true,
      "title": "Append Only Decision Required",
      "type": "boolean"
    },
    "human_review_required": {
      "const": true,
      "default": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "orchestrator_owner_for_runtime_capture": {
      "const": true,
      "default": true,
      "title": "Orchestrator Owner For Runtime Capture",
      "type": "boolean"
    },
    "exception_lake_owner_for_admission": {
      "const": true,
      "default": true,
      "title": "Exception Lake Owner For Admission",
      "type": "boolean"
    },
    "not_authorized_for_lake_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Lake Write",
      "type": "boolean"
    },
    "not_authorized_for_sqlite_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Sqlite Write",
      "type": "boolean"
    },
    "not_authorized_for_external_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For External Write",
      "type": "boolean"
    },
    "not_authorized_for_budget_submission": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Budget Submission",
      "type": "boolean"
    },
    "not_authorized_for_carrier_submission": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Carrier Submission",
      "type": "boolean"
    },
    "no_connector_implemented": {
      "const": true,
      "default": true,
      "title": "No Connector Implemented",
      "type": "boolean"
    },
    "no_lake_admission_performed": {
      "const": true,
      "default": true,
      "title": "No Lake Admission Performed",
      "type": "boolean"
    },
    "no_sibling_repo_writes": {
      "const": true,
      "default": true,
      "title": "No Sibling Repo Writes",
      "type": "boolean"
    },
    "no_canonical_mutation": {
      "const": true,
      "default": true,
      "title": "No Canonical Mutation",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "billing_connector_read_performed": {
      "const": false,
      "default": false,
      "title": "Billing Connector Read Performed",
      "type": "boolean"
    },
    "billing_connector_write_performed": {
      "const": false,
      "default": false,
      "title": "Billing Connector Write Performed",
      "type": "boolean"
    },
    "carrier_portal_write_performed": {
      "const": false,
      "default": false,
      "title": "Carrier Portal Write Performed",
      "type": "boolean"
    },
    "email_send_performed": {
      "const": false,
      "default": false,
      "title": "Email Send Performed",
      "type": "boolean"
    },
    "appeal_submission_performed": {
      "const": false,
      "default": false,
      "title": "Appeal Submission Performed",
      "type": "boolean"
    },
    "budget_submission_performed": {
      "const": false,
      "default": false,
      "title": "Budget Submission Performed",
      "type": "boolean"
    },
    "budget_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Budget Mutation Performed",
      "type": "boolean"
    },
    "profile_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Profile Mutation Performed",
      "type": "boolean"
    },
    "template_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Template Mutation Performed",
      "type": "boolean"
    },
    "carrier_guideline_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Carrier Guideline Mutation Performed",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "budget_human_review_packet_id",
    "status",
    "source_budget_lifecycle_audit_report_id",
    "source_budget_lifecycle_audit_report_ref",
    "source_budget_lifecycle_audit_status",
    "financial_summary",
    "pending_human_decision_count",
    "required_review_sections",
    "recommendations",
    "red_team_notes",
    "decision_templates",
    "checks",
    "required_next_gates",
    "generated_at"
  ],
  "title": "BudgetHumanReviewPacket",
  "type": "object"
}
