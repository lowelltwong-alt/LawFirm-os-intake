        "not_ready_missing_local_artifacts",
        "not_ready_learning_artifact_chain_blocked",
        "not_ready_lake_bundle_blocked",
        "not_ready_calibration_readiness_blocked",
        "not_ready_fixture_update_review_blocked",
        "not_ready_fixture_update_pr_package_blocked"
      ],
      "title": "Review Readiness",
      "type": "string"
    },
    "source_owner_handoff_report_ref": {
      "title": "Source Owner Handoff Report Ref",
      "type": "string"
    },
    "source_budget_event_lake_bundle_report_ref": {
      "title": "Source Budget Event Lake Bundle Report Ref",
      "type": "string"
    },
    "source_budget_calibration_readiness_report_ref": {
      "title": "Source Budget Calibration Readiness Report Ref",
      "type": "string"
    },
    "source_budget_fixture_update_review_report_ref": {
      "title": "Source Budget Fixture Update Review Report Ref",
      "type": "string"
    },
    "source_budget_fixture_update_pr_package_report_ref": {
      "title": "Source Budget Fixture Update Pr Package Report Ref",
      "type": "string"
    },
    "total_slice_count": {
      "minimum": 0,
      "title": "Total Slice Count",
      "type": "integer"
    },
    "implemented_slice_count": {
      "minimum": 0,
      "title": "Implemented Slice Count",
      "type": "integer"
    },
    "missing_artifact_refs": {
      "items": {
        "type": "string"
      },
      "title": "Missing Artifact Refs",
      "type": "array"
    },
    "missing_command_refs": {
      "items": {
        "type": "string"
      },
      "title": "Missing Command Refs",
      "type": "array"
    },
    "slices": {
      "items": {
        "$ref": "#/$defs/IntakeVerticalReadinessSliceStatus"
      },
      "title": "Slices",
      "type": "array"
    },
    "artifact_checks": {
      "items": {
        "$ref": "#/$defs/IntakeVerticalReadinessArtifactCheck"
      },
      "title": "Artifact Checks",
      "type": "array"
    },
    "required_external_adoption_actions": {
      "items": {
        "type": "string"
      },
      "title": "Required External Adoption Actions",
      "type": "array"
    },
    "external_adoption_target_repos": {
      "items": {
        "enum": [
          "LawFirm-os-intake",
          "LawFirm-os-orchestrator",
          "LawFirm-os-exceptions-lake-runtime",
          "LawFirm-os-semantic-substrate"
        ],
        "type": "string"
      },
      "title": "External Adoption Target Repos",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "local_completion_scope": {
      "const": "synthetic_candidate_only",
