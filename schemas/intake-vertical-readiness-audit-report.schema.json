      "title": "Local Completion Scope",
      "type": "string"
    },
    "pr_marked_ready": {
      "const": false,
      "default": false,
      "title": "Pr Marked Ready",
      "type": "boolean"
    },
    "promotion_authorized": {
      "const": false,
      "default": false,
      "title": "Promotion Authorized",
      "type": "boolean"
    },
    "proposed_changes_applied": {
      "const": false,
      "default": false,
      "title": "Proposed Changes Applied",
      "type": "boolean"
    },
    "baseline_mutated": {
      "const": false,
      "default": false,
      "title": "Baseline Mutated",
      "type": "boolean"
    },
    "no_connector_implemented": {
      "const": true,
      "default": true,
      "title": "No Connector Implemented",
      "type": "boolean"
    },
    "no_lake_admission_performed": {
      "const": true,
      "default": true,
      "title": "No Lake Admission Performed",
      "type": "boolean"
    },
    "no_sibling_repo_writes": {
      "const": true,
      "default": true,
      "title": "No Sibling Repo Writes",
      "type": "boolean"
    },
    "no_canonical_mutation": {
      "const": true,
      "default": true,
      "title": "No Canonical Mutation",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "audit_report_id",
    "status",
    "review_readiness",
    "source_owner_handoff_report_ref",
    "source_budget_event_lake_bundle_report_ref",
    "source_budget_calibration_readiness_report_ref",
    "source_budget_fixture_update_review_report_ref",
    "source_budget_fixture_update_pr_package_report_ref",
    "total_slice_count",
    "implemented_slice_count",
    "slices",
    "artifact_checks",
    "required_external_adoption_actions",
    "external_adoption_target_repos",
    "generated_at"
