{
  "$defs": {
    "RenderedMatterDocument": {
      "additionalProperties": false,
      "properties": {
        "doc_type": {
          "enum": [
            "complaint",
            "answer",
            "expert_disclosure",
            "demand_letter",
            "scheduling_order",
            "discovery_requests"
          ],
          "title": "Doc Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "doc_type",
        "text"
      ],
      "title": "RenderedMatterDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One driver-stratified synthetic med-mal matter with observable evidence.",
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "case_id": {
      "title": "Case Id",
      "type": "string"
    },
    "line_id": {
      "title": "Line Id",
      "type": "string"
    },
    "subtype": {
      "title": "Subtype",
      "type": "string"
    },
    "difficulty": {
      "enum": [
        "clear",
        "moderate",
        "hard"
      ],
      "title": "Difficulty",
      "type": "string"
    },
    "explicit_driver_levels": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Explicit Driver Levels",
      "type": "object"
    },
    "observable_driver_evidence": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Observable Driver Evidence",
      "type": "object"
    },
    "documents": {
      "items": {
        "$ref": "#/$defs/RenderedMatterDocument"
      },
      "title": "Documents",
      "type": "array"
    },
    "signal_terms_used": {
      "items": {
        "type": "string"
      },
      "title": "Signal Terms Used",
      "type": "array"
    },
    "distractor_terms_used": {
      "items": {
        "type": "string"
      },
      "title": "Distractor Terms Used",
      "type": "array"
    },
    "exposure_minor_units": {
      "exclusiveMinimum": 0,
      "title": "Exposure Minor Units",
      "type": "integer"
    },
    "profile_id": {
      "title": "Profile Id",
      "type": "string"
    },
    "plan_id": {
      "title": "Plan Id",
      "type": "string"
    },
    "canonical_total_minor_units": {
      "exclusiveMinimum": 0,
      "title": "Canonical Total Minor Units",
      "type": "integer"
    },
    "contract_digest": {
      "title": "Contract Digest",
      "type": "string"
    },
    "holdout_split": {
      "enum": [
        "train",
        "holdout"
      ],
      "title": "Holdout Split",
      "type": "string"
    },
    "budget_stated_in_documents": {
      "const": false,
      "default": false,
      "title": "Budget Stated In Documents",
      "type": "boolean"
    },
    "reference_class_only": {
      "const": true,
      "default": true,
      "title": "Reference Class Only",
      "type": "boolean"
    },
    "calibrated": {
      "const": false,
      "default": false,
      "title": "Calibrated",
      "type": "boolean"
    },
    "real_world_accuracy_claim": {
      "const": false,
      "default": false,
      "title": "Real World Accuracy Claim",
      "type": "boolean"
    },
    "data_scope": {
      "const": "synthetic_only",
      "default": "synthetic_only",
      "title": "Data Scope",
      "type": "string"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    }
  },
  "required": [
    "case_id",
    "line_id",
    "subtype",
    "difficulty",
    "explicit_driver_levels",
    "observable_driver_evidence",
    "documents",
    "exposure_minor_units",
    "profile_id",
    "plan_id",
    "canonical_total_minor_units",
    "contract_digest",
    "holdout_split"
  ],
  "title": "StratifiedSyntheticMatter",
  "type": "object"
}
