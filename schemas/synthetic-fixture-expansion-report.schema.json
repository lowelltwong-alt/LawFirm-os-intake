        "$ref": "#/$defs/SyntheticFixtureExpansionCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "calibration_approved": {
      "const": false,
      "default": false,
      "title": "Calibration Approved",
      "type": "boolean"
    },
    "fixture_files_mutated_by_audit": {
      "const": false,
      "default": false,
      "title": "Fixture Files Mutated By Audit",
      "type": "boolean"
    },
    "github_issue_created": {
      "const": false,
      "default": false,
