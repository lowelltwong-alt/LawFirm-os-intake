      "type": "string"
    },
    "source_remaining_roadmap_report_id": {
      "title": "Source Remaining Roadmap Report Id",
      "type": "string"
    },
    "source_remaining_roadmap_report_ref": {
      "title": "Source Remaining Roadmap Report Ref",
      "type": "string"
    },
