{
  "$defs": {
    "SyntheticFixtureExpansionCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        },
        "blocking_refs": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Refs",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "SyntheticFixtureExpansionCheck",
      "type": "object"
    },
    "SyntheticFixtureExpansionHoldoutSpec": {
      "additionalProperties": false,
      "properties": {
        "holdout_id": {
          "title": "Holdout Id",
          "type": "string"
        },
        "family": {
          "enum": [
            "ambiguous_roles",
            "missing_actuals",
            "carrier_rejection_variants",
            "budget_driver_edges"
          ],
          "title": "Family",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "fixture_refs": {
          "items": {
            "type": "string"
          },
          "title": "Fixture Refs",
          "type": "array"
        },
        "test_refs": {
          "items": {
            "type": "string"
          },
          "title": "Test Refs",
          "type": "array"
        },
        "expected_signals": {
          "items": {
            "type": "string"
          },
          "title": "Expected Signals",
          "type": "array"
        },
        "red_team_notes": {
          "items": {
            "type": "string"
          },
          "title": "Red Team Notes",
          "type": "array"
        },
        "synthetic_only": {
          "const": true,
          "default": true,
          "title": "Synthetic Only",
          "type": "boolean"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        },
        "calibration_approved": {
          "const": false,
          "default": false,
          "title": "Calibration Approved",
          "type": "boolean"
        },
        "fixture_files_mutated_by_audit": {
          "const": false,
          "default": false,
          "title": "Fixture Files Mutated By Audit",
          "type": "boolean"
        },
        "lake_write_performed": {
          "const": false,
          "default": false,
          "title": "Lake Write Performed",
          "type": "boolean"
        },
        "sqlite_write_performed": {
          "const": false,
          "default": false,
          "title": "Sqlite Write Performed",
          "type": "boolean"
        },
        "external_writes_performed": {
          "const": false,
          "default": false,
          "title": "External Writes Performed",
          "type": "boolean"
        },
        "silent_learning_performed": {
          "const": false,
          "default": false,
          "title": "Silent Learning Performed",
          "type": "boolean"
        }
      },
      "required": [
        "holdout_id",
        "family",
        "description",
        "fixture_refs",
        "test_refs",
        "expected_signals",
        "red_team_notes"
      ],
      "title": "SyntheticFixtureExpansionHoldoutSpec",
      "type": "object"
    }
