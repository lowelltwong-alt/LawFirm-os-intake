      "type": "string"
    },
    "source_remaining_roadmap_item_status": {
      "title": "Source Remaining Roadmap Item Status",
      "type": "string"
    },
    "manifest_id": {
      "title": "Manifest Id",
      "type": "string"
    },
    "manifest_ref": {
      "title": "Manifest Ref",
      "type": "string"
    },
    "required_family_count": {
      "minimum": 0,
      "title": "Required Family Count",
      "type": "integer"
    },
    "holdout_count": {
      "minimum": 0,
      "title": "Holdout Count",
      "type": "integer"
    },
    "family_counts": {
