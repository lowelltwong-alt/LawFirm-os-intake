  "required": [
    "fixture_expansion_report_id",
    "status",
    "source_remaining_roadmap_report_id",
    "source_remaining_roadmap_report_ref",
    "source_remaining_roadmap_status",
    "source_remaining_roadmap_item_id",
    "source_remaining_roadmap_item_status",
    "manifest_id",
    "manifest_ref",
    "required_family_count",
    "holdout_count",
