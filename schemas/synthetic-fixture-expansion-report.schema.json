      "type": "boolean"
    },
    "github_pr_created": {
      "const": false,
      "default": false,
      "title": "Github Pr Created",
      "type": "boolean"
    },
    "github_write_performed": {
      "const": false,
      "default": false,
      "title": "Github Write Performed",
      "type": "boolean"
    },
    "sibling_repo_write_performed": {
      "const": false,
      "default": false,
      "title": "Sibling Repo Write Performed",
      "type": "boolean"
    },
    "promotion_authorized": {
      "const": false,
      "default": false,
      "title": "Promotion Authorized",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
