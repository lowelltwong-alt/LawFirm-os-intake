      "title": "Source Kind",
      "type": "string"
    },
    "source_refs": {
      "items": {
        "type": "string"
      },
      "title": "Source Refs",
      "type": "array"
    },
    "prs": {
      "items": {
        "$ref": "#/$defs/PRMergeOrderSnapshotItem"
      },
      "title": "Prs",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "human_review_required": {
      "const": true,
      "default": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "manual_github_action_required": {
      "const": true,
      "default": true,
      "title": "Manual Github Action Required",
      "type": "boolean"
    },
    "not_authorized_for_external_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For External Write",
      "type": "boolean"
    },
    "not_authorized_for_lake_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Lake Write",
      "type": "boolean"
    },
    "not_authorized_for_sqlite_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Sqlite Write",
      "type": "boolean"
    },
    "ready_for_review_marked": {
      "const": false,
      "default": false,
      "title": "Ready For Review Marked",
      "type": "boolean"
    },
    "merge_performed": {
      "const": false,
      "default": false,
      "title": "Merge Performed",
      "type": "boolean"
    },
    "github_issue_created": {
      "const": false,
      "default": false,
      "title": "Github Issue Created",
      "type": "boolean"
    },
    "github_pr_created": {
      "const": false,
      "default": false,
      "title": "Github Pr Created",
      "type": "boolean"
    },
    "github_write_performed": {
      "const": false,
      "default": false,
      "title": "Github Write Performed",
      "type": "boolean"
    },
    "sibling_repo_write_performed": {
      "const": false,
      "default": false,
      "title": "Sibling Repo Write Performed",
      "type": "boolean"
    },
    "promotion_authorized": {
      "const": false,
      "default": false,
      "title": "Promotion Authorized",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    }
  },
  "required": [
    "snapshot_id",
    "repository_full_name",
    "base_ref_name",
    "observed_at",
    "source_kind",
    "source_refs",
    "prs"
  ],
  "title": "PRMergeOrderSnapshot",
  "type": "object"
}
