      "required": [
        "status",
        "candidate_count",
        "carrier_learning_candidate_count",
        "budget_revision_candidate_count",
        "budget_actual_variance_candidate_count"
      ],
      "title": "BudgetLearningLoopReviewedGateSummary",
      "type": "object"
    }
