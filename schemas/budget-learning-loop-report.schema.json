        "parser_failure_count": {
          "minimum": 0,
          "title": "Parser Failure Count",
          "type": "integer"
        },
        "appeal_result_count": {
          "minimum": 0,
          "title": "Appeal Result Count",
          "type": "integer"
        },
        "remediation_case_count": {
          "minimum": 0,
          "title": "Remediation Case Count",
          "type": "integer"
        },
        "decision_ledger_entry_count": {
          "minimum": 0,
          "title": "Decision Ledger Entry Count",
          "type": "integer"
        },
        "pending_decision_event_count": {
          "minimum": 0,
          "title": "Pending Decision Event Count",
          "type": "integer"
        },
        "total_disputed_amount": {
          "minimum": 0,
          "title": "Total Disputed Amount",
          "type": "number"
        },
        "total_recovered_amount": {
          "minimum": 0,
          "title": "Total Recovered Amount",
          "type": "number"
        },
        "total_write_down_amount": {
          "minimum": 0,
          "title": "Total Write Down Amount",
          "type": "number"
        },
        "candidate_event_labels": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Event Labels",
          "type": "array"
        }
      },
      "required": [
        "reconciliation_status",
        "decision_ledger_status",
        "expected_response_count",
        "reconciled_response_count",
        "missing_response_count",
        "unlinked_notice_count",
        "duplicate_notice_count",
        "parser_failure_count",
        "appeal_result_count",
        "remediation_case_count",
        "decision_ledger_entry_count",
        "pending_decision_event_count",
        "total_disputed_amount",
        "total_recovered_amount",
        "total_write_down_amount"
      ],
      "title": "BudgetLearningLoopCarrierRejectionSummary",
      "type": "object"
    },
    "BudgetLearningLoopLane": {
      "additionalProperties": false,
      "properties": {
        "lane_id": {
          "title": "Lane Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "state": {
          "enum": [
            "passed",
            "pending",
            "blocked",
            "failed"
          ],
          "title": "State",
          "type": "string"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "why": {
          "title": "Why",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "candidate_exception_lake_labels": {
          "items": {
            "type": "string"
