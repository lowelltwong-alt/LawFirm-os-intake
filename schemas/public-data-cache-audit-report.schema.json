          "title": "Source Id",
          "type": "string"
        },
        "source_url": {
          "title": "Source Url",
          "type": "string"
        },
        "source_type": {
          "title": "Source Type",
          "type": "string"
        },
        "retrieved_at": {
          "title": "Retrieved At",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "byte_count": {
          "minimum": 0,
          "title": "Byte Count",
          "type": "integer"
        },
        "cache_ref": {
          "title": "Cache Ref",
          "type": "string"
        },
        "license_terms_note": {
          "title": "License Terms Note",
          "type": "string"
        },
        "allowed_use": {
          "title": "Allowed Use",
          "type": "string"
        },
        "prohibited_use": {
          "title": "Prohibited Use",
          "type": "string"
        },
        "retention_posture": {
          "title": "Retention Posture",
          "type": "string"
        },
        "data_origin": {
          "const": "public_reference_cache",
