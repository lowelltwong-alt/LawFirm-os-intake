{
  "$defs": {
    "RustUIBundleSourceHashDetail": {
      "additionalProperties": false,
      "properties": {
        "detail_report_id": {
          "title": "Detail Report Id",
          "type": "string"
        },
        "report_kind": {
          "title": "Report Kind",
          "type": "string"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "actual_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Sha256"
        },
        "resolved_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Path"
        },
        "resolution_strategy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Strategy"
        },
        "status": {
          "enum": [
            "matched",
            "hash_mismatch",
            "source_missing",
            "invalid_source_hash",
            "skipped_not_present"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "detail_report_id",
        "report_kind",
        "file_name",
        "status"
      ],
      "title": "RustUIBundleSourceHashDetail",
      "type": "object"
    },
    "RustUIBundleSourceHashFailure": {
      "additionalProperties": false,
      "properties": {
        "detail_report_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail Report Id"
        },
        "file_name": {
          "title": "File Name",
          "type": "string"
        },
        "check": {
          "title": "Check",
          "type": "string"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected Sha256"
        },
        "actual_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Sha256"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "file_name",
        "check",
        "message"
      ],
      "title": "RustUIBundleSourceHashFailure",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "checker": {
      "const": "ui-bundle-source-hash-checker",
      "title": "Checker",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "root": {
      "title": "Root",
      "type": "string"
    },
    "bundle_ref": {
      "title": "Bundle Ref",
      "type": "string"
    },
    "detail_report_count": {
      "minimum": 0,
      "title": "Detail Report Count",
      "type": "integer"
    },
    "present_detail_report_count": {
      "minimum": 0,
      "title": "Present Detail Report Count",
      "type": "integer"
    },
    "checked_detail_report_count": {
      "minimum": 0,
      "title": "Checked Detail Report Count",
      "type": "integer"
    },
    "matched_detail_report_count": {
      "minimum": 0,
      "title": "Matched Detail Report Count",
      "type": "integer"
    },
    "hash_mismatch_count": {
      "minimum": 0,
      "title": "Hash Mismatch Count",
      "type": "integer"
    },
    "missing_source_file_count": {
      "minimum": 0,
      "title": "Missing Source File Count",
      "type": "integer"
    },
    "invalid_source_hash_count": {
      "minimum": 0,
      "title": "Invalid Source Hash Count",
      "type": "integer"
    },
    "skipped_detail_report_count": {
      "minimum": 0,
      "title": "Skipped Detail Report Count",
      "type": "integer"
    },
    "checker_error_count": {
      "minimum": 0,
      "title": "Checker Error Count",
      "type": "integer"
    },
    "details": {
      "items": {
        "$ref": "#/$defs/RustUIBundleSourceHashDetail"
      },
      "title": "Details",
      "type": "array"
    },
    "failure_count": {
      "minimum": 0,
      "title": "Failure Count",
      "type": "integer"
    },
    "failures": {
      "items": {
        "$ref": "#/$defs/RustUIBundleSourceHashFailure"
      },
      "title": "Failures",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "local_json_only": {
      "const": true,
      "default": true,
      "title": "Local Json Only",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "budget_submission_authorized": {
      "const": false,
      "default": false,
      "title": "Budget Submission Authorized",
      "type": "boolean"
    },
    "matter_opening_authorized": {
      "const": false,
      "default": false,
      "title": "Matter Opening Authorized",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    }
  },
  "required": [
    "checker",
    "status",
    "root",
    "bundle_ref",
    "detail_report_count",
    "present_detail_report_count",
    "checked_detail_report_count",
    "matched_detail_report_count",
    "hash_mismatch_count",
    "missing_source_file_count",
    "invalid_source_hash_count",
    "skipped_detail_report_count",
    "checker_error_count",
    "failure_count"
  ],
  "title": "RustUIBundleSourceHashReport",
  "type": "object"
}
