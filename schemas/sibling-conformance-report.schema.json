{
  "additionalProperties": false,
  "description": "Read-only conformance of the sibling billing-guideline-simulator vs CW1 outputs.",
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sibling_repo_ref": {
      "title": "Sibling Repo Ref",
      "type": "string"
    },
    "sibling_available": {
      "title": "Sibling Available",
      "type": "boolean"
    },
    "status": {
      "enum": [
        "passed",
        "divergences_found",
        "blocked_sibling_unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "checked_cw1_output_refs": {
      "items": {
        "type": "string"
      },
      "title": "Checked Cw1 Output Refs",
      "type": "array"
    },
    "divergences": {
      "items": {
        "type": "string"
      },
      "title": "Divergences",
      "type": "array"
    },
    "recorded_reason": {
      "title": "Recorded Reason",
      "type": "string"
    },
    "read_only": {
      "const": true,
      "default": true,
      "title": "Read Only",
      "type": "boolean"
    },
    "sibling_is_read_only_challenger": {
      "const": true,
      "default": true,
      "title": "Sibling Is Read Only Challenger",
      "type": "boolean"
    }
  },
  "required": [
    "sibling_repo_ref",
    "sibling_available",
    "status",
    "recorded_reason"
  ],
  "title": "SiblingConformanceReport",
  "type": "object"
}
