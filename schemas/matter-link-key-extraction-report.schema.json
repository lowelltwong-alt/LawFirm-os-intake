{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "start_offset": {
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "title": "End Offset",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "segment_id",
        "start_offset",
        "end_offset",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MatterLinkKey": {
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "title": "Key Id",
          "type": "string"
        },
        "key_type": {
          "enum": [
            "claim_number",
            "policy_number",
            "docket_ref",
            "adjuster_ref",
            "party_pair",
            "employer_employee_pair",
            "counsel_ref",
            "email_thread",
            "attachment_identity",
            "incident_date_party",
            "subsidiary_alias"
          ],
          "title": "Key Type",
          "type": "string"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "string"
        },
        "normalized_value": {
          "title": "Normalized Value",
          "type": "string"
        },
        "tier": {
          "enum": [
            "strong",
            "medium",
            "weak"
          ],
          "title": "Tier",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "extraction_rule_id": {
          "title": "Extraction Rule Id",
          "type": "string"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "key_type",
        "raw_value",
        "normalized_value",
        "tier",
        "evidence_refs",
        "extraction_rule_id"
      ],
      "title": "MatterLinkKey",
      "type": "object"
    },
    "MatterLinkKeyExtractionCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "document_ids": {
          "items": {
            "type": "string"
          },
          "title": "Document Ids",
          "type": "array"
        },
        "key_ids": {
          "items": {
            "type": "string"
          },
          "title": "Key Ids",
          "type": "array"
        },
        "blocking_refs": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Refs",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "MatterLinkKeyExtractionCheck",
      "type": "object"
    },
    "MatterLinkKeySet": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "bundle_id": {
          "title": "Bundle Id",
          "type": "string"
        },
        "sender_identity": {
          "title": "Sender Identity",
          "type": "string"
        },
        "keys": {
          "items": {
            "$ref": "#/$defs/MatterLinkKey"
          },
          "title": "Keys",
          "type": "array"
        },
        "extraction_gaps": {
          "items": {
            "type": "string"
          },
          "title": "Extraction Gaps",
          "type": "array"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "bundle_id",
        "sender_identity"
      ],
      "title": "MatterLinkKeySet",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "matter_link_key_extraction_report_id": {
      "title": "Matter Link Key Extraction Report Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "matter_link_keys_extracted_for_review",
        "blocked_matter_link_key_extraction"
      ],
      "title": "Status",
      "type": "string"
    },
    "bundle_id": {
      "title": "Bundle Id",
      "type": "string"
    },
    "policy_ref": {
      "title": "Policy Ref",
      "type": "string"
    },
    "policy_sha256": {
      "title": "Policy Sha256",
      "type": "string"
    },
    "document_count": {
      "minimum": 0,
      "title": "Document Count",
      "type": "integer"
    },
    "key_count": {
      "minimum": 0,
      "title": "Key Count",
      "type": "integer"
    },
    "key_sets": {
      "items": {
        "$ref": "#/$defs/MatterLinkKeySet"
      },
      "title": "Key Sets",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/MatterLinkKeyExtractionCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "required_next_gates": {
      "items": {
        "type": "string"
      },
      "title": "Required Next Gates",
      "type": "array"
    },
    "candidate_exception_lake_labels": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Exception Lake Labels",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "local_json_only": {
      "const": true,
      "default": true,
      "title": "Local Json Only",
      "type": "boolean"
    },
    "human_review_required": {
      "const": true,
      "default": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "no_clustering_performed": {
      "const": true,
      "default": true,
      "title": "No Clustering Performed",
      "type": "boolean"
    },
    "matter_identity_asserted": {
      "const": false,
      "default": false,
      "title": "Matter Identity Asserted",
      "type": "boolean"
    },
    "matter_link_finalized": {
      "const": false,
      "default": false,
      "title": "Matter Link Finalized",
      "type": "boolean"
    },
    "sender_identity_used_as_link_key": {
      "const": false,
      "default": false,
      "title": "Sender Identity Used As Link Key",
      "type": "boolean"
    },
    "fuzzy_matching_performed": {
      "const": false,
      "default": false,
      "title": "Fuzzy Matching Performed",
      "type": "boolean"
    },
    "acronym_inference_performed": {
      "const": false,
      "default": false,
      "title": "Acronym Inference Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "matter_opening_authorized": {
      "const": false,
      "default": false,
      "title": "Matter Opening Authorized",
      "type": "boolean"
    },
    "budget_amount_output_authorized": {
      "const": false,
      "default": false,
      "title": "Budget Amount Output Authorized",
      "type": "boolean"
    },
    "budget_submission_authorized": {
      "const": false,
      "default": false,
      "title": "Budget Submission Authorized",
      "type": "boolean"
    },
    "conflict_conclusion_emitted": {
      "const": false,
      "default": false,
      "title": "Conflict Conclusion Emitted",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "matter_link_key_extraction_report_id",
    "status",
    "bundle_id",
    "policy_ref",
    "policy_sha256",
    "document_count",
    "key_count",
    "key_sets",
    "checks",
    "required_next_gates",
    "candidate_exception_lake_labels",
    "generated_at"
