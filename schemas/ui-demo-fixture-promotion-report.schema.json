      "type": "string"
    },
    "fixtures_root_ref": {
      "title": "Fixtures Root Ref",
      "type": "string"
    },
    "promotion_item_count": {
      "minimum": 0,
      "title": "Promotion Item Count",
      "type": "integer"
    },
    "promoted_item_count": {
      "minimum": 0,
      "title": "Promoted Item Count",
      "type": "integer"
    },
    "unchanged_item_count": {
      "minimum": 0,
      "title": "Unchanged Item Count",
      "type": "integer"
    },
    "generated_wrapper_count": {
      "minimum": 0,
      "title": "Generated Wrapper Count",
      "type": "integer"
    },
    "missing_source_count": {
      "minimum": 0,
      "title": "Missing Source Count",
      "type": "integer"
    },
    "ambiguous_source_count": {
      "minimum": 0,
      "title": "Ambiguous Source Count",
      "type": "integer"
    },
    "blocked_side_effect_count": {
      "minimum": 0,
      "title": "Blocked Side Effect Count",
      "type": "integer"
    },
    "sanitized_replacement_count": {
      "minimum": 0,
      "title": "Sanitized Replacement Count",
      "type": "integer"
    },
    "forbidden_run_root_leak_count": {
      "minimum": 0,
      "title": "Forbidden Run Root Leak Count",
      "type": "integer"
    },
    "rust_boundary_status": {
      "title": "Rust Boundary Status",
      "type": "string"
    },
    "wrapper_refresh_status": {
      "title": "Wrapper Refresh Status",
      "type": "string"
    },
    "manifest_status": {
      "title": "Manifest Status",
      "type": "string"
    },
    "source_hash_gate_status": {
      "title": "Source Hash Gate Status",
      "type": "string"
    },
    "snapshot_gate_status": {
      "title": "Snapshot Gate Status",
      "type": "string"
    },
    "wrapper_refresh_report_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Wrapper Refresh Report Ref"
    },
    "old_ui_review_data_bundle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Old Ui Review Data Bundle Id"
    },
    "new_ui_review_data_bundle_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Ui Review Data Bundle Id"
    },
    "local_fixture_updates_performed": {
      "default": false,
      "title": "Local Fixture Updates Performed",
      "type": "boolean"
    },
    "rollback_performed": {
      "default": false,
      "title": "Rollback Performed",
      "type": "boolean"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/UIDemoFixturePromotionItem"
      },
      "title": "Items",
      "type": "array"
    },
    "required_next_actions": {
      "items": {
        "type": "string"
      },
      "title": "Required Next Actions",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "local_json_only": {
      "const": true,
      "default": true,
      "title": "Local Json Only",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "budget_submission_authorized": {
      "const": false,
      "default": false,
      "title": "Budget Submission Authorized",
      "type": "boolean"
    },
    "matter_opening_authorized": {
      "const": false,
      "default": false,
      "title": "Matter Opening Authorized",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
