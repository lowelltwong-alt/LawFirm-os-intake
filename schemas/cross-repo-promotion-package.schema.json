{
  "$defs": {
    "CrossRepoPromotionProposal": {
      "additionalProperties": false,
      "properties": {
        "proposal_id": {
          "title": "Proposal Id",
          "type": "string"
        },
        "target_repo": {
          "enum": [
            "LawFirm-os-semantic-substrate",
            "LawFirm-os-orchestrator",
            "LawFirm-os-exceptions-lake-runtime",
            "LawFirm-os-skills-registry",
            "LawFirm-os-legal-knowledge-runtime"
          ],
          "title": "Target Repo",
          "type": "string"
        },
        "authority_plane": {
          "enum": [
            "control",
            "execution",
            "evidence",
            "skills_registry",
            "legal_knowledge_runtime"
          ],
          "title": "Authority Plane",
          "type": "string"
        },
        "proposal_type": {
          "enum": [
            "schema_contract",
            "event_label_mapping",
            "workflow_interface",
            "lake_evidence_mapping",
            "skill_metadata",
            "context_bundle_interface"
          ],
          "title": "Proposal Type",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "candidate_artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Candidate Artifact Refs",
          "type": "array"
        },
        "proposed_contract_refs": {
          "items": {
            "type": "string"
          },
          "title": "Proposed Contract Refs",
          "type": "array"
        },
        "required_governance_actions": {
          "items": {
            "type": "string"
          },
          "title": "Required Governance Actions",
          "type": "array"
        },
        "promotion_blockers": {
          "items": {
            "type": "string"
          },
          "title": "Promotion Blockers",
          "type": "array"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        },
        "direct_promotion_performed": {
          "const": false,
          "default": false,
          "title": "Direct Promotion Performed",
          "type": "boolean"
        },
        "external_writes_performed": {
          "const": false,
          "default": false,
          "title": "External Writes Performed",
          "type": "boolean"
        }
      },
      "required": [
        "proposal_id",
        "target_repo",
        "authority_plane",
        "proposal_type",
        "summary"
      ],
      "title": "CrossRepoPromotionProposal",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "package_id": {
      "title": "Package Id",
      "type": "string"
    },
    "status": {
      "const": "candidate_only",
      "title": "Status",
      "type": "string"
    },
    "origin_repo": {
      "const": "LawFirm-os-intake",
      "default": "LawFirm-os-intake",
      "title": "Origin Repo",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "reviewed_lock_status": {
      "const": "reviewed_seed_lock",
      "title": "Reviewed Lock Status",
      "type": "string"
    },
    "target_repos": {
      "items": {
        "enum": [
          "LawFirm-os-semantic-substrate",
          "LawFirm-os-orchestrator",
          "LawFirm-os-exceptions-lake-runtime",
          "LawFirm-os-skills-registry",
          "LawFirm-os-legal-knowledge-runtime"
        ],
        "type": "string"
      },
      "title": "Target Repos",
      "type": "array"
    },
    "proposals": {
      "items": {
        "$ref": "#/$defs/CrossRepoPromotionProposal"
      },
      "title": "Proposals",
      "type": "array"
    },
    "promotion_rule": {
      "title": "Promotion Rule",
      "type": "string"
    },
    "no_canonical_mutation": {
      "const": true,
      "default": true,
      "title": "No Canonical Mutation",
      "type": "boolean"
    },
    "no_sibling_repo_writes": {
      "const": true,
      "default": true,
      "title": "No Sibling Repo Writes",
      "type": "boolean"
    },
    "no_external_writes_performed": {
      "const": true,
      "default": true,
      "title": "No External Writes Performed",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    }
  },
  "required": [
    "package_id",
    "status",
    "generated_at",
    "reviewed_lock_status",
    "target_repos",
    "proposals",
    "promotion_rule"
  ],
  "title": "CrossRepoPromotionPackage",
  "type": "object"
}
