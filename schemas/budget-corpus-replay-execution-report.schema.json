{
  "$defs": {
    "BudgetCorpusReplayCaseResult": {
      "additionalProperties": false,
      "properties": {
        "replay_case_id": {
          "title": "Replay Case Id",
          "type": "string"
        },
        "source_artifact_ref": {
          "title": "Source Artifact Ref",
          "type": "string"
        },
        "artifact_kind": {
          "enum": [
            "intake_source_fixture",
            "human_confirmation_fixture",
            "budget_review_fixture",
            "actuals_fixture",
            "carrier_rejection_fixture",
            "reviewed_gold_fixture",
            "learning_gate_fixture",
            "learning_shadow_eval_fixture",
            "learning_support_fixture",
            "unclassified_json_fixture"
          ],
          "title": "Artifact Kind",
          "type": "string"
        },
        "status": {
          "enum": [
            "dry_run_ready",
            "executed_passed",
            "executed_failed",
            "skipped_not_selected",
            "skipped_supporting_context",
            "blocked"
          ],
          "title": "Status",
          "type": "string"
        },
        "command_results": {
          "items": {
            "$ref": "#/$defs/BudgetCorpusReplayCommandResult"
          },
          "title": "Command Results",
          "type": "array"
        },
        "output_checks": {
          "items": {
            "$ref": "#/$defs/BudgetCorpusReplayOutputCheck"
          },
          "title": "Output Checks",
          "type": "array"
        },
        "blocking_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Reasons",
          "type": "array"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        },
        "synthetic_only": {
          "const": true,
          "default": true,
          "title": "Synthetic Only",
          "type": "boolean"
        },
        "calibration_applied": {
          "const": false,
          "default": false,
          "title": "Calibration Applied",
          "type": "boolean"
        },
        "profile_mutation_performed": {
          "const": false,
          "default": false,
          "title": "Profile Mutation Performed",
          "type": "boolean"
        },
        "template_mutation_performed": {
          "const": false,
          "default": false,
          "title": "Template Mutation Performed",
          "type": "boolean"
        },
        "budget_mutation_performed": {
          "const": false,
          "default": false,
          "title": "Budget Mutation Performed",
          "type": "boolean"
        },
        "carrier_guideline_mutation_performed": {
          "const": false,
          "default": false,
          "title": "Carrier Guideline Mutation Performed",
          "type": "boolean"
        },
        "lake_write_performed": {
          "const": false,
          "default": false,
          "title": "Lake Write Performed",
          "type": "boolean"
        },
        "sqlite_write_performed": {
          "const": false,
          "default": false,
          "title": "Sqlite Write Performed",
          "type": "boolean"
        },
        "external_writes_performed": {
          "const": false,
          "default": false,
          "title": "External Writes Performed",
          "type": "boolean"
        },
        "silent_learning_performed": {
          "const": false,
          "default": false,
          "title": "Silent Learning Performed",
          "type": "boolean"
        }
      },
      "required": [
        "replay_case_id",
        "source_artifact_ref",
        "artifact_kind",
        "status"
      ],
      "title": "BudgetCorpusReplayCaseResult",
      "type": "object"
    },
    "BudgetCorpusReplayCommandResult": {
      "additionalProperties": false,
      "properties": {
        "command_id": {
          "title": "Command Id",
          "type": "string"
        },
        "replay_case_id": {
          "title": "Replay Case Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "planned_only_not_executed",
            "executed_passed",
            "executed_failed",
            "skipped_not_selected",
            "skipped_supporting_context",
            "blocked_from_plan",
            "blocked_missing_input",
            "blocked_prior_command_failed",
            "blocked_unsupported_command",
            "blocked_missing_placeholder"
          ],
          "title": "Status",
          "type": "string"
        },
        "execution_mode": {
          "enum": [
            "dry_run",
            "execute"
          ],
          "title": "Execution Mode",
          "type": "string"
        },
        "planned_command": {
          "title": "Planned Command",
          "type": "string"
        },
        "resolved_command": {
          "title": "Resolved Command",
          "type": "string"
        },
        "return_code": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Return Code"
        },
        "stdout_excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stdout Excerpt"
        },
        "stderr_excerpt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stderr Excerpt"
        },
        "output_checks": {
          "items": {
            "$ref": "#/$defs/BudgetCorpusReplayOutputCheck"
          },
          "title": "Output Checks",
          "type": "array"
        },
        "blocking_reasons": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Reasons",
          "type": "array"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "not_authorized_for_external_write": {
          "const": true,
          "default": true,
          "title": "Not Authorized For External Write",
          "type": "boolean"
        },
        "not_authorized_for_lake_write": {
          "const": true,
          "default": true,
          "title": "Not Authorized For Lake Write",
          "type": "boolean"
        },
        "calibration_applied": {
          "const": false,
          "default": false,
          "title": "Calibration Applied",
          "type": "boolean"
        },
        "profile_mutation_performed": {
          "const": false,
          "default": false,
          "title": "Profile Mutation Performed",
          "type": "boolean"
        },
        "template_mutation_performed": {
          "const": false,
          "default": false,
          "title": "Template Mutation Performed",
          "type": "boolean"
        },
        "budget_mutation_performed": {
          "const": false,
          "default": false,
          "title": "Budget Mutation Performed",
          "type": "boolean"
        },
        "carrier_guideline_mutation_performed": {
          "const": false,
          "default": false,
          "title": "Carrier Guideline Mutation Performed",
          "type": "boolean"
        },
        "lake_write_performed": {
          "const": false,
          "default": false,
          "title": "Lake Write Performed",
          "type": "boolean"
        },
        "sqlite_write_performed": {
          "const": false,
          "default": false,
          "title": "Sqlite Write Performed",
          "type": "boolean"
        },
        "external_writes_performed": {
          "const": false,
          "default": false,
          "title": "External Writes Performed",
          "type": "boolean"
        },
        "silent_learning_performed": {
          "const": false,
          "default": false,
          "title": "Silent Learning Performed",
          "type": "boolean"
        }
      },
      "required": [
        "command_id",
        "replay_case_id",
        "status",
        "execution_mode",
        "planned_command",
        "resolved_command"
      ],
      "title": "BudgetCorpusReplayCommandResult",
      "type": "object"
    },
    "BudgetCorpusReplayExecutionCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Case Ids",
          "type": "array"
        },
        "command_ids": {
          "items": {
            "type": "string"
          },
          "title": "Command Ids",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "BudgetCorpusReplayExecutionCheck",
      "type": "object"
    },
    "BudgetCorpusReplayOutputCheck": {
      "additionalProperties": false,
      "properties": {
        "output_ref": {
          "title": "Output Ref",
          "type": "string"
        },
        "resolved_output_path": {
          "title": "Resolved Output Path",
          "type": "string"
        },
        "exists": {
          "title": "Exists",
          "type": "boolean"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        },
        "size_bytes": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Size Bytes"
        }
      },
      "required": [
        "output_ref",
        "resolved_output_path",
        "exists"
      ],
      "title": "BudgetCorpusReplayOutputCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "replay_execution_report_id": {
      "title": "Replay Execution Report Id",
      "type": "string"
    },
    "replay_plan_id": {
      "title": "Replay Plan Id",
      "type": "string"
    },
    "replay_plan_ref": {
      "title": "Replay Plan Ref",
      "type": "string"
    },
    "execution_mode": {
      "enum": [
        "dry_run",
        "execute"
      ],
      "title": "Execution Mode",
      "type": "string"
    },
    "status": {
      "enum": [
        "dry_run_ready_for_review",
        "execution_passed_for_review",
        "execution_failed",
        "blocked_by_plan",
        "no_executable_cases"
      ],
      "title": "Status",
      "type": "string"
    },
    "replay_run_root": {
      "title": "Replay Run Root",
      "type": "string"
    },
    "selected_case_ids": {
      "items": {
        "type": "string"
      },
      "title": "Selected Case Ids",
      "type": "array"
    },
    "case_count": {
      "minimum": 0,
      "title": "Case Count",
      "type": "integer"
    },
    "executed_case_count": {
      "minimum": 0,
      "title": "Executed Case Count",
      "type": "integer"
    },
    "dry_run_case_count": {
      "minimum": 0,
      "title": "Dry Run Case Count",
      "type": "integer"
    },
    "skipped_case_count": {
      "minimum": 0,
      "title": "Skipped Case Count",
      "type": "integer"
    },
    "blocked_case_count": {
      "minimum": 0,
      "title": "Blocked Case Count",
      "type": "integer"
    },
    "failed_case_count": {
      "minimum": 0,
      "title": "Failed Case Count",
      "type": "integer"
    },
    "command_count": {
      "minimum": 0,
      "title": "Command Count",
      "type": "integer"
    },
    "executed_command_count": {
      "minimum": 0,
      "title": "Executed Command Count",
      "type": "integer"
    },
    "failed_command_count": {
      "minimum": 0,
      "title": "Failed Command Count",
      "type": "integer"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/BudgetCorpusReplayCaseResult"
      },
      "title": "Cases",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/BudgetCorpusReplayExecutionCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "required_next_gates": {
      "items": {
        "type": "string"
      },
      "title": "Required Next Gates",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "calibration_applied": {
      "const": false,
      "default": false,
      "title": "Calibration Applied",
      "type": "boolean"
    },
    "profile_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Profile Mutation Performed",
      "type": "boolean"
    },
    "template_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Template Mutation Performed",
      "type": "boolean"
    },
    "budget_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Budget Mutation Performed",
      "type": "boolean"
    },
    "carrier_guideline_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Carrier Guideline Mutation Performed",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "replay_execution_report_id",
    "replay_plan_id",
    "replay_plan_ref",
    "execution_mode",
    "status",
    "replay_run_root",
    "case_count",
    "executed_case_count",
    "dry_run_case_count",
    "skipped_case_count",
    "blocked_case_count",
    "failed_case_count",
    "command_count",
    "executed_command_count",
    "failed_command_count",
    "cases",
    "checks",
    "required_next_gates",
    "generated_at"
  ],
  "title": "BudgetCorpusReplayExecutionReport",
  "type": "object"
}
