          "type": "string"
        },
        "missing_critical_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missing Critical Fact Ids",
          "type": "array"
        },
        "missing_important_fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Missing Important Fact Ids",
          "type": "array"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        }
      },
      "required": [
        "pack_case_id",
        "family",
        "variant",
        "coverage_state",
        "expected_budget_readiness_state",
        "expected_budget_treatment"
