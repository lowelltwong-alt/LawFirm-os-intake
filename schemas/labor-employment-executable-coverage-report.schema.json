    "LaborEmploymentExecutableCoverageCase": {
      "additionalProperties": false,
      "properties": {
        "pack_case_id": {
          "title": "Pack Case Id",
          "type": "string"
        },
        "family": {
          "enum": [
            "discrimination_harassment",
            "retaliation_wrongful_termination",
            "wage_hour_flsa_state",
            "ada_fmla_accommodation_leave",
            "restrictive_covenant_trade_secret",
            "epli_carrier_assignment",
            "class_collective_paga_representative",
            "administrative_exhaustion_agency_record"
          ],
          "title": "Family",
          "type": "string"
        },
        "variant": {
          "enum": [
            "clean",
            "messy_thread",
            "missing_attachment",
            "adversarial"
          ],
          "title": "Variant",
          "type": "string"
        },
        "coverage_state": {
          "enum": [
            "covered_executable",
            "missing_executable"
          ],
          "title": "Coverage State",
          "type": "string"
        },
        "executable_fixture_ids": {
          "items": {
            "type": "string"
          },
          "title": "Executable Fixture Ids",
          "type": "array"
        },
        "expected_budget_readiness_state": {
          "enum": [
            "blocked_missing_critical_facts",
            "range_only_pending_human_review",
            "candidate_ready_for_budget_review"
          ],
          "title": "Expected Budget Readiness State",
          "type": "string"
        },
        "expected_budget_treatment": {
          "enum": [
            "block_amount_budget",
            "hours_only_or_broad_range",
            "candidate_range_budget_after_review"
          ],
