    },
    "authoritative_firm_wide_provenance_manifest_verified": {
      "const": false,
      "title": "Authoritative Firm Wide Provenance Manifest Verified",
      "type": "boolean"
    },
    "consuming_context_scope_known": {
      "const": true,
      "title": "Consuming Context Scope Known",
      "type": "boolean"
    },
    "contains_real_data": {
      "const": false,
      "title": "Contains Real Data",
      "type": "boolean"
    },
    "contains_private_data": {
      "const": false,
      "title": "Contains Private Data",
      "type": "boolean"
    },
    "contains_client_data": {
      "const": false,
      "title": "Contains Client Data",
      "type": "boolean"
    },
    "contains_matter_data": {
      "const": false,
      "title": "Contains Matter Data",
      "type": "boolean"
    },
    "contains_real_carrier_data": {
      "const": false,
      "title": "Contains Real Carrier Data",
      "type": "boolean"
    },
    "contains_privileged_content": {
      "const": false,
      "title": "Contains Privileged Content",
      "type": "boolean"
    },
    "contains_work_product": {
      "const": false,
      "title": "Contains Work Product",
