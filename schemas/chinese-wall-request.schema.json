    "synthetic_adversity_graph_digest": {
      "const": "sha256:355b0c259de100e4000211e26e4c38b9b69c0e3c4f9a6927c8d5ff5e34b762a4",
      "title": "Synthetic Adversity Graph Digest",
      "type": "string"
    },
    "synthetic_case_manifest_digest": {
