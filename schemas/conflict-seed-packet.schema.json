        "normalized_term": {
          "title": "Normalized Term",
          "type": "string"
        },
        "group": {
          "enum": [
            "prospective_represented_client",
            "instructing_source",
            "payer",
            "insured",
            "adverse_party",
            "opposing_counsel",
            "alias",
            "unresolved_role"
          ],
          "title": "Group",
          "type": "string"
        },
        "source_role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
