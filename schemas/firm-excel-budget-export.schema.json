{
  "$defs": {
    "FirmExcelBudgetPhase": {
      "additionalProperties": false,
      "properties": {
        "utbms_phase_code": {
          "title": "Utbms Phase Code",
          "type": "string"
        },
        "phase_name": {
          "title": "Phase Name",
          "type": "string"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/FirmExcelBudgetTaskRow"
          },
          "title": "Tasks",
          "type": "array"
        }
      },
      "required": [
        "utbms_phase_code",
        "phase_name"
      ],
      "title": "FirmExcelBudgetPhase",
      "type": "object"
    },
    "FirmExcelBudgetTaskRow": {
      "additionalProperties": false,
      "properties": {
        "utbms_task_code": {
          "title": "Utbms Task Code",
          "type": "string"
        },
        "task_name": {
          "title": "Task Name",
          "type": "string"
        },
        "original_amount_minor_units": {
          "minimum": 0,
          "title": "Original Amount Minor Units",
          "type": "integer"
        },
        "billed_amount_minor_units": {
          "minimum": 0,
          "title": "Billed Amount Minor Units",
          "type": "integer"
        },
        "new_amount_minor_units": {
          "minimum": 0,
          "title": "New Amount Minor Units",
          "type": "integer"
        }
      },
      "required": [
        "utbms_task_code",
        "task_name",
        "original_amount_minor_units",
        "billed_amount_minor_units",
        "new_amount_minor_units"
      ],
      "title": "FirmExcelBudgetTaskRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured firm-Excel budget export (dollars-per-UTBMS-task only).\n\nThe role/rate/hours decomposition stays internal to the engine; only dollars\nper task are exported. Candidate-only, synthetic-only; not a client submission.",
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "export_id": {
      "title": "Export Id",
      "type": "string"
    },
    "matter_label": {
      "default": "SYNTHETIC MATTER (candidate, not a real client)",
      "title": "Matter Label",
      "type": "string"
    },
    "currency": {
      "default": "USD",
      "title": "Currency",
      "type": "string"
    },
    "phases": {
      "items": {
        "$ref": "#/$defs/FirmExcelBudgetPhase"
      },
      "title": "Phases",
      "type": "array"
    },
    "original_total_minor_units": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Original Total Minor Units"
    },
    "billed_total_minor_units": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Billed Total Minor Units"
    },
    "new_total_minor_units": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "New Total Minor Units"
    },
    "documented_deviations": {
      "items": {
        "type": "string"
      },
      "title": "Documented Deviations",
      "type": "array"
    },
    "data_scope": {
      "const": "synthetic_only",
      "default": "synthetic_only",
      "title": "Data Scope",
      "type": "string"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "not_authorized_for_client_submission": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Client Submission",
      "type": "boolean"
    }
  },
  "required": [
    "export_id"
  ],
  "title": "FirmExcelBudgetExport",
  "type": "object"
}
