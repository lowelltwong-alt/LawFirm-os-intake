{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "start_offset": {
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "title": "End Offset",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "segment_id",
        "start_offset",
        "end_offset",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "review_outcome_id": {
      "title": "Review Outcome Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "preflight_packet_id": {
      "title": "Preflight Packet Id",
      "type": "string"
    },
    "confirmation_preflight_packet_id": {
      "title": "Confirmation Preflight Packet Id",
      "type": "string"
    },
    "confirmation_id": {
      "title": "Confirmation Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "confirmed",
        "needs_more_information",
        "unknown",
        "human_only",
        "declined",
        "declined_or_referred"
      ],
      "title": "Status",
      "type": "string"
    },
    "reviewer_id": {
      "title": "Reviewer Id",
      "type": "string"
    },
    "reviewed_at": {
      "title": "Reviewed At",
      "type": "string"
    },
    "supersedes_confirmation_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Confirmation Id"
    },
    "mutation_policy": {
      "const": "append_or_supersede_only",
      "default": "append_or_supersede_only",
      "title": "Mutation Policy",
      "type": "string"
    },
    "matches_preflight_packet": {
      "title": "Matches Preflight Packet",
      "type": "boolean"
    },
    "budget_stage_allowed": {
      "title": "Budget Stage Allowed",
      "type": "boolean"
    },
    "required_next_gate": {
      "enum": [
        "budget_precondition_gate",
        "collect_missing_information",
        "human_classification_correction",
        "human_only_handling",
        "declined_or_referred_handoff"
      ],
      "title": "Required Next Gate",
      "type": "string"
    },
    "decision_evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Decision Evidence Refs",
      "type": "array"
    },
    "confirmed_party_evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Confirmed Party Evidence Refs",
      "type": "array"
    },
    "confirmed_party_count": {
      "title": "Confirmed Party Count",
      "type": "integer"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    }
  },
  "required": [
    "review_outcome_id",
    "run_id",
    "preflight_packet_id",
    "confirmation_preflight_packet_id",
    "confirmation_id",
    "status",
    "reviewer_id",
    "reviewed_at",
    "matches_preflight_packet",
    "budget_stage_allowed",
    "required_next_gate",
    "confirmed_party_count"
  ],
  "title": "HumanReviewOutcomeRecord",
  "type": "object"
}
