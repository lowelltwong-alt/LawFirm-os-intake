{
  "$defs": {
    "CarrierRejectionReviewDecisionTemplate": {
      "additionalProperties": false,
      "properties": {
        "remediation_case_id": {
          "title": "Remediation Case Id",
          "type": "string"
        },
        "allowed_outcomes": {
          "items": {
            "enum": [
              "confirm_classification",
              "correct_classification",
              "confirm_linkage",
              "correct_linkage",
              "needs_more_information",
              "appeal",
              "no_appeal",
              "accept_write_down",
              "fix_and_resubmit",
              "record_appeal_result",
              "human_only",
              "close_no_action",
              "create_learning_candidate",
              "no_learning_change"
            ],
            "type": "string"
          },
          "title": "Allowed Outcomes",
          "type": "array"
        },
        "required_fields": {
          "items": {
            "type": "string"
          },
          "title": "Required Fields",
          "type": "array"
        },
        "mutation_policy": {
          "const": "append_or_supersede_only",
          "default": "append_or_supersede_only",
          "title": "Mutation Policy",
          "type": "string"
        },
        "external_submission_authorized": {
          "const": false,
          "default": false,
          "title": "External Submission Authorized",
          "type": "boolean"
        },
        "silent_learning_allowed": {
          "const": false,
          "default": false,
          "title": "Silent Learning Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "remediation_case_id",
        "allowed_outcomes",
        "required_fields"
      ],
      "title": "CarrierRejectionReviewDecisionTemplate",
      "type": "object"
    },
    "CarrierRejectionReviewRecommendation": {
      "additionalProperties": false,
      "properties": {
        "recommendation_id": {
          "title": "Recommendation Id",
          "type": "string"
        },
        "remediation_case_id": {
          "title": "Remediation Case Id",
          "type": "string"
        },
        "local_event_label": {
          "title": "Local Event Label",
          "type": "string"
        },
        "recommended_action": {
          "enum": [
            "appeal_review_required",
            "confirm_missing_response_followup",
            "link_or_escalate_unlinked_notice",
            "parse_repair_required",
            "record_appeal_result",
            "human_decision_required"
          ],
          "title": "Recommended Action",
          "type": "string"
        },
        "priority": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "human_owner": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Owner"
        },
        "followup_due_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Followup Due At"
        },
        "financial_exposure": {
          "default": 0,
          "minimum": 0,
          "title": "Financial Exposure",
          "type": "number"
        },
        "source_ref_count": {
          "minimum": 0,
          "title": "Source Ref Count",
          "type": "integer"
        },
        "source_channels": {
          "items": {
            "type": "string"
          },
          "title": "Source Channels",
          "type": "array"
        },
        "why": {
          "items": {
            "type": "string"
          },
          "title": "Why",
          "type": "array"
        },
        "required_human_decisions": {
          "items": {
            "type": "string"
          },
          "title": "Required Human Decisions",
          "type": "array"
        },
        "learning_disposition_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Learning Disposition Candidates",
          "type": "array"
        },
        "exception_candidate_ids": {
          "items": {
            "type": "string"
          },
          "title": "Exception Candidate Ids",
          "type": "array"
        },
        "not_authorized_for_external_submission": {
          "const": true,
          "default": true,
          "title": "Not Authorized For External Submission",
          "type": "boolean"
        },
        "not_authorized_for_lake_write": {
          "const": true,
          "default": true,
          "title": "Not Authorized For Lake Write",
          "type": "boolean"
        }
      },
      "required": [
        "recommendation_id",
        "remediation_case_id",
        "local_event_label",
        "recommended_action",
        "priority",
        "source_ref_count",
        "why"
      ],
      "title": "CarrierRejectionReviewRecommendation",
      "type": "object"
    },
    "CarrierRejectionReviewRedTeamNote": {
      "additionalProperties": false,
      "properties": {
        "note_id": {
          "title": "Note Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "critical",
            "high",
            "medium",
            "low"
          ],
          "title": "Severity",
          "type": "string"
        },
        "scope": {
          "enum": [
            "capture_completeness",
            "idempotency",
            "linkage",
            "parser_failure",
            "financial_math",
            "human_authority",
            "learning_loop",
            "boundary"
          ],
          "title": "Scope",
          "type": "string"
        },
        "remediation_case_ids": {
          "items": {
            "type": "string"
          },
          "title": "Remediation Case Ids",
          "type": "array"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "recommended_check": {
          "title": "Recommended Check",
          "type": "string"
        }
      },
      "required": [
        "note_id",
        "severity",
        "scope",
        "message",
        "recommended_check"
      ],
      "title": "CarrierRejectionReviewRedTeamNote",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "review_packet_id": {
      "title": "Review Packet Id",
      "type": "string"
    },
    "reconciliation_report_id": {
      "title": "Reconciliation Report Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "preflight_packet_id": {
      "title": "Preflight Packet Id",
      "type": "string"
    },
    "budget_proposal_id": {
      "title": "Budget Proposal Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready_for_human_review",
        "blocked_missing_required_followup",
        "no_cases_to_review"
      ],
      "title": "Status",
      "type": "string"
    },
    "expected_response_count": {
      "minimum": 0,
      "title": "Expected Response Count",
      "type": "integer"
    },
    "reconciled_response_count": {
      "minimum": 0,
      "title": "Reconciled Response Count",
      "type": "integer"
    },
    "missing_response_count": {
      "minimum": 0,
      "title": "Missing Response Count",
      "type": "integer"
    },
    "unlinked_notice_count": {
      "minimum": 0,
      "title": "Unlinked Notice Count",
      "type": "integer"
    },
    "duplicate_notice_count": {
      "minimum": 0,
      "title": "Duplicate Notice Count",
      "type": "integer"
    },
    "parser_failure_count": {
      "minimum": 0,
      "title": "Parser Failure Count",
      "type": "integer"
    },
    "appeal_result_count": {
      "minimum": 0,
      "title": "Appeal Result Count",
      "type": "integer"
    },
    "remediation_case_count": {
      "minimum": 0,
      "title": "Remediation Case Count",
      "type": "integer"
    },
    "total_financial_exposure": {
      "minimum": 0,
      "title": "Total Financial Exposure",
      "type": "number"
    },
    "dry_run_exception_candidate_count": {
      "minimum": 0,
      "title": "Dry Run Exception Candidate Count",
      "type": "integer"
    },
    "recommendations": {
      "items": {
        "$ref": "#/$defs/CarrierRejectionReviewRecommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "red_team_notes": {
      "items": {
        "$ref": "#/$defs/CarrierRejectionReviewRedTeamNote"
      },
      "title": "Red Team Notes",
      "type": "array"
    },
    "decision_templates": {
      "items": {
        "$ref": "#/$defs/CarrierRejectionReviewDecisionTemplate"
      },
      "title": "Decision Templates",
      "type": "array"
    },
    "dry_run_exception_candidate_ids": {
      "items": {
        "type": "string"
      },
      "title": "Dry Run Exception Candidate Ids",
      "type": "array"
    },
    "gap_report": {
      "items": {
        "type": "string"
      },
      "title": "Gap Report",
      "type": "array"
    },
    "allowed_reviewer_outcomes": {
      "items": {
        "type": "string"
      },
      "title": "Allowed Reviewer Outcomes",
      "type": "array"
    },
    "required_review_sections": {
      "items": {
        "type": "string"
      },
      "title": "Required Review Sections",
      "type": "array"
    },
    "human_readable_review_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Readable Review Ref"
    },
    "mutation_policy": {
      "const": "append_or_supersede_only",
      "default": "append_or_supersede_only",
      "title": "Mutation Policy",
      "type": "string"
    },
    "target_orchestrator_owner": {
      "const": "LawFirm-os-orchestrator",
      "default": "LawFirm-os-orchestrator",
      "title": "Target Orchestrator Owner",
      "type": "string"
    },
    "target_exception_lake_owner": {
      "const": "LawFirm-os-exceptions-lake-runtime",
      "default": "LawFirm-os-exceptions-lake-runtime",
      "title": "Target Exception Lake Owner",
      "type": "string"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "not_authorized_for_lake_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Lake Write",
      "type": "boolean"
    },
    "not_authorized_for_external_submission": {
      "const": true,
      "default": true,
      "title": "Not Authorized For External Submission",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "review_packet_id",
    "reconciliation_report_id",
    "run_id",
    "preflight_packet_id",
    "budget_proposal_id",
    "status",
    "expected_response_count",
    "reconciled_response_count",
    "missing_response_count",
    "unlinked_notice_count",
    "duplicate_notice_count",
    "parser_failure_count",
    "appeal_result_count",
    "remediation_case_count",
    "total_financial_exposure",
    "dry_run_exception_candidate_count",
    "recommendations",
    "red_team_notes",
    "decision_templates",
    "allowed_reviewer_outcomes",
    "required_review_sections",
    "generated_at"
  ],
  "title": "CarrierRejectionReviewPacket",
  "type": "object"
}
