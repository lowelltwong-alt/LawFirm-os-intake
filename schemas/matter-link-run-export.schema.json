{
  "$defs": {
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "start_offset": {
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "title": "End Offset",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "segment_id",
        "start_offset",
        "end_offset",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "MatterClusterProposal": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "cluster_id": {
          "title": "Cluster Id",
          "type": "string"
        },
        "document_ids": {
          "items": {
            "type": "string"
          },
          "title": "Document Ids",
          "type": "array"
        },
        "ambiguity_class": {
          "enum": [
            "corroborated_multi_key",
            "single_strong_key",
            "medium_key_only",
            "weak_key_only",
            "conflicted"
          ],
          "title": "Ambiguity Class",
          "type": "string"
        },
        "supporting_keys": {
          "items": {
            "$ref": "#/$defs/MatterLinkKey"
          },
          "title": "Supporting Keys",
          "type": "array"
        },
        "conflicting_keys": {
          "items": {
            "$ref": "#/$defs/MatterLinkKey"
          },
          "title": "Conflicting Keys",
          "type": "array"
        },
        "disposition": {
          "enum": [
            "proposed_link",
            "hold_for_more_documents",
            "human_review_required",
            "blocked_conflict"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "decision_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Decision Rule Ids",
          "type": "array"
        },
        "decision_ids": {
          "items": {
            "type": "string"
          },
          "title": "Decision Ids",
          "type": "array"
        },
        "blocking_decision_ids": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Decision Ids",
          "type": "array"
        },
        "requires_human_confirmation": {
          "const": true,
          "default": true,
          "title": "Requires Human Confirmation",
          "type": "boolean"
        },
        "matter_identity_asserted": {
          "const": false,
          "default": false,
          "title": "Matter Identity Asserted",
          "type": "boolean"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "cluster_id",
        "document_ids",
        "ambiguity_class",
        "disposition",
        "decision_rule_ids",
        "decision_ids"
      ],
      "title": "MatterClusterProposal",
      "type": "object"
    },
    "MatterLinkDecisionRecord": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "left_document_id": {
          "title": "Left Document Id",
          "type": "string"
        },
        "right_document_id": {
          "title": "Right Document Id",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "merge",
            "split",
            "hold",
            "block"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "ambiguity_signal": {
          "title": "Ambiguity Signal",
          "type": "string"
        },
        "supporting_key_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Key Ids",
          "type": "array"
        },
        "conflicting_key_ids": {
          "items": {
            "type": "string"
          },
          "title": "Conflicting Key Ids",
          "type": "array"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "left_document_id",
        "right_document_id",
        "rule_id",
        "outcome",
        "ambiguity_signal",
        "note"
      ],
      "title": "MatterLinkDecisionRecord",
      "type": "object"
    },
    "MatterLinkHumanDecision": {
      "additionalProperties": false,
      "description": "Candidate contract for the only matter-linking decision eligible for persistence.\n\nThe subject is a hash of normalized link keys rather than a run-local document or\ncluster identifier, so an Orchestrator-owned ledger can safely apply it to later\nbundles without treating an intake proposal as a durable identity assertion.",
      "properties": {
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "decided_at": {
          "title": "Decided At",
          "type": "string"
        },
        "reviewer_id": {
          "title": "Reviewer Id",
          "type": "string"
        },
        "decision_type": {
          "enum": [
            "confirm_cluster",
            "split",
            "merge",
            "reopen",
            "retire"
          ],
          "title": "Decision Type",
          "type": "string"
        },
        "subject_key_signatures": {
          "items": {
            "type": "string"
          },
          "title": "Subject Key Signatures",
          "type": "array"
        },
        "evidence_key_ids": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Key Ids",
          "type": "array"
        },
        "observable_rationale": {
          "title": "Observable Rationale",
          "type": "string"
        },
        "supersedes_decision_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Decision Id"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "identity_authority": {
          "const": false,
          "default": false,
          "title": "Identity Authority",
          "type": "boolean"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "decided_at",
        "reviewer_id",
        "decision_type",
        "subject_key_signatures",
        "evidence_key_ids",
        "observable_rationale"
      ],
      "title": "MatterLinkHumanDecision",
      "type": "object"
    },
    "MatterLinkKey": {
      "additionalProperties": false,
      "properties": {
        "key_id": {
          "title": "Key Id",
