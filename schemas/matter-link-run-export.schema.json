          "title": "Tier",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "extraction_rule_id": {
          "title": "Extraction Rule Id",
          "type": "string"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "key_type",
        "raw_value",
        "normalized_value",
        "tier",
        "evidence_refs",
        "extraction_rule_id"
      ],
      "title": "MatterLinkKey",
      "type": "object"
    },
    "MatterLinkKeySet": {
      "additionalProperties": false,
