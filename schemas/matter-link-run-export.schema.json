          "title": "Key Type",
          "type": "string"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "string"
        },
        "normalized_value": {
          "title": "Normalized Value",
          "type": "string"
        },
        "tier": {
          "enum": [
            "strong",
            "medium",
            "weak"
