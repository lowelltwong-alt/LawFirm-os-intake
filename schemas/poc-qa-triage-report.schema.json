      "type": "integer"
    },
    "passed_item_count": {
      "minimum": 0,
      "title": "Passed Item Count",
      "type": "integer"
    },
    "needs_review_item_count": {
      "minimum": 0,
      "title": "Needs Review Item Count",
      "type": "integer"
    },
    "watch_item_count": {
      "minimum": 0,
      "title": "Watch Item Count",
      "type": "integer"
    },
    "blocked_item_count": {
      "minimum": 0,
