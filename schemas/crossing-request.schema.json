        },
        "synthetic_context_digest": {
          "const": "sha256:c6b440e60be46ad0982ffd25de45e43fbc21638d7042aa040c681fff6c731da7",
          "title": "Synthetic Context Digest",
          "type": "string"
        },
        "publication_snapshot_id": {
          "minLength": 1,
          "pattern": "^synthetic-[a-z0-9-]+$",
          "title": "Publication Snapshot Id",
