        },
        "publication_snapshot_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Publication Snapshot Digest",
          "type": "string"
        },
        "authoritative_publication_snapshot_verified": {
          "const": false,
          "title": "Authoritative Publication Snapshot Verified",
          "type": "boolean"
        },
        "published_lessons": {
          "items": {
            "$ref": "#/$defs/PublishedLessonProjection"
          },
          "title": "Published Lessons",
          "type": "array"
        }
      },
      "required": [
        "request_id",
        "lesson",
        "policy",
        "lattice",
        "universe",
        "synthetic_lesson_fixture_digest",
        "synthetic_context_digest",
        "publication_snapshot_id",
        "publication_snapshot_digest",
        "authoritative_publication_snapshot_verified",
        "published_lessons"
      ],
      "title": "LessonDisclosureRequest",
      "type": "object"
    },
