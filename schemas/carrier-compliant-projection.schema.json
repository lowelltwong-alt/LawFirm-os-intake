{
  "$defs": {
    "AdjustmentLedger": {
      "additionalProperties": false,
      "description": "Ordered, non-commutative-safe attribution of every projection adjustment.\n\nPer-rule deltas are recomputed from the entries and must sum to the category\ndeltas and the total delta (fail-closed). Candidate-only review evidence.",
      "properties": {
        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "attribution_order": {
          "items": {
            "type": "string"
          },
          "title": "Attribution Order",
          "type": "array"
        },
        "entries": {
          "items": {
            "$ref": "#/$defs/AdjustmentLedgerEntry"
          },
          "title": "Entries",
          "type": "array"
        },
        "category_delta_minor_units": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Category Delta Minor Units",
          "type": "object"
        },
        "total_delta_minor_units": {
          "default": 0,
          "title": "Total Delta Minor Units",
          "type": "integer"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        }
      },
      "title": "AdjustmentLedger",
      "type": "object"
    },
    "AdjustmentLedgerEntry": {
      "additionalProperties": false,
      "description": "One ordered, rule-attributed adjustment effect, in exact integer minor units.\n\n``delta_minor_units`` is the signed reduction (positive reduces the proposal);\n``after_minor_units == before_minor_units - delta_minor_units`` exactly.",
      "properties": {
        "order_index": {
          "minimum": 0,
          "title": "Order Index",
          "type": "integer"
        },
        "rule_kind": {
          "enum": [
            "pack_effective_selection",
            "task_hour_cap",
            "staffing_rule",
            "rate_cap",
            "expense_cap",
            "disallowance",
            "contingency",
            "preapproval_unsupported"
          ],
          "title": "Rule Kind",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Id"
        },
        "phase_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase Id"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "before_minor_units": {
          "title": "Before Minor Units",
          "type": "integer"
        },
        "after_minor_units": {
          "title": "After Minor Units",
          "type": "integer"
        },
        "delta_minor_units": {
          "title": "Delta Minor Units",
          "type": "integer"
        },
        "note": {
          "default": "",
          "title": "Note",
          "type": "string"
        }
      },
      "required": [
        "order_index",
        "rule_kind",
        "rule_id",
        "before_minor_units",
        "after_minor_units",
        "delta_minor_units"
      ],
      "title": "AdjustmentLedgerEntry",
      "type": "object"
    },
