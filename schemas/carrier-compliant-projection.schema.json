    "PackSelectionDecision": {
      "additionalProperties": false,
      "description": "Typed, fail-closed carrier guideline pack selection.\n\nA missing or wrong confirmed carrier yields ``blocked_missing_context`` and\nnever silently falls back to a default carrier pack. Candidate-only review\nevidence; it authorizes no submission and asserts no canonical authority.",
      "properties": {
        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "selected",
            "blocked_missing_context",
            "blocked_overlap",
            "no_applicable_pack"
          ],
          "title": "Status",
          "type": "string"
        },
        "confirmed_carrier_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
