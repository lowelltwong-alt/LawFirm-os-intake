        "data_scope": {
          "const": "synthetic_only",
          "default": "synthetic_only",
          "title": "Data Scope",
          "type": "string"
        },
        "candidate_only": {
          "const": true,
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        },
        "not_authorized_for_client_submission": {
          "const": true,
          "default": true,
          "title": "Not Authorized For Client Submission",
          "type": "boolean"
        }
      },
      "required": [
