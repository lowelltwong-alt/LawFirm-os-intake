          ],
          "default": null,
          "title": "Work Plan Total"
        },
        "guideline_adjusted_reimbursement": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Guideline Adjusted Reimbursement"
        },
        "unreimbursed_exposure": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unreimbursed Exposure"
        },
        "reimbursement_priced": {
          "title": "Reimbursement Priced",
          "type": "boolean"
        },
        "work_plan_is_immutable_baseline": {
          "const": true,
          "default": true,
          "title": "Work Plan Is Immutable Baseline",
          "type": "boolean"
        },
        "non_authoritative": {
          "const": true,
          "default": true,
          "title": "Non Authoritative",
          "type": "boolean"
        }
      },
      "required": [
        "reimbursement_priced"
      ],
      "title": "ProjectionReport",
      "type": "object"
    }
  },
