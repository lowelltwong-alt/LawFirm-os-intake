      ],
      "title": "PackSelectionDecision",
      "type": "object"
    },
    "ProjectionReport": {
      "additionalProperties": false,
      "description": "The three distinct output quantities, kept semantically separate.\n\n``work_plan_total`` is the firm's immutable work-plan baseline and is NEVER\noverwritten by reimbursement math; ``guideline_adjusted_reimbursement`` is\nwhat the carrier guideline would reimburse; ``unreimbursed_exposure`` is the\ngap the firm/client bears (work_plan_total - reimbursement), recomputed\nfail-closed. Candidate-only review evidence.",
      "properties": {
        "schema_version": {
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "currency": {
          "default": "USD",
          "title": "Currency",
          "type": "string"
        },
        "work_plan_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
