{
  "$defs": {
    "CrosswalkAuditFinding": {
      "additionalProperties": false,
      "properties": {
        "crosswalk_id": {
          "title": "Crosswalk Id",
          "type": "string"
        },
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "warning",
            "info"
          ],
          "title": "Severity",
          "type": "string"
        },
        "issue": {
          "title": "Issue",
          "type": "string"
        },
        "entry_local_term": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entry Local Term"
        }
      },
      "required": [
        "crosswalk_id",
        "finding_id",
        "severity",
        "issue"
      ],
      "title": "CrosswalkAuditFinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "report_id": {
      "title": "Report Id",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "acceptance_gate_status": {
      "enum": [
        "accepted_with_restrictions",
        "blocked"
      ],
      "title": "Acceptance Gate Status",
      "type": "string"
    },
    "crosswalk_count": {
      "minimum": 0,
      "title": "Crosswalk Count",
      "type": "integer"
    },
    "entry_count": {
      "minimum": 0,
      "title": "Entry Count",
      "type": "integer"
    },
    "mapped_entry_count": {
      "minimum": 0,
      "title": "Mapped Entry Count",
      "type": "integer"
    },
    "unmapped_entry_count": {
      "minimum": 0,
      "title": "Unmapped Entry Count",
      "type": "integer"
    },
    "canonical_claim_count": {
      "minimum": 0,
      "title": "Canonical Claim Count",
      "type": "integer"
    },
    "candidate_only_violation_count": {
      "minimum": 0,
      "title": "Candidate Only Violation Count",
      "type": "integer"
    },
    "entries_missing_provenance_count": {
      "minimum": 0,
      "title": "Entries Missing Provenance Count",
      "type": "integer"
    },
    "entries_missing_review_status_count": {
      "minimum": 0,
      "title": "Entries Missing Review Status Count",
      "type": "integer"
    },
    "guessed_mapping_count": {
      "minimum": 0,
      "title": "Guessed Mapping Count",
      "type": "integer"
    },
    "high_confidence_dual_review_violation_count": {
      "default": 0,
      "minimum": 0,
      "title": "High Confidence Dual Review Violation Count",
      "type": "integer"
    },
    "utbms_like_candidate_family_label_count": {
      "default": 0,
      "minimum": 0,
      "title": "Utbms Like Candidate Family Label Count",
      "type": "integer"
    },
    "exact_standard_code_verified": {
      "default": false,
      "title": "Exact Standard Code Verified",
      "type": "boolean"
    },
    "unverified_pinned_target_count": {
      "default": 0,
      "minimum": 0,
      "title": "Unverified Pinned Target Count",
      "type": "integer"
    },
    "candidate_target_prefix_violation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Candidate Target Prefix Violation Count",
      "type": "integer"
    },
    "workflow_dependency_violation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Workflow Dependency Violation Count",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/CrosswalkAuditFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "crosswalk_refs": {
      "items": {
        "type": "string"
      },
      "title": "Crosswalk Refs",
      "type": "array"
    },
    "candidate_only": {
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "not_promoted_canon": {
      "default": true,
      "title": "Not Promoted Canon",
      "type": "boolean"
    },
    "prohibited_actions": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Actions",
      "type": "array"
    },
    "display_banner": {
      "additionalProperties": true,
      "title": "Display Banner",
      "type": "object"
    },
    "not_authorized_for_canonical_use": {
      "default": true,
      "title": "Not Authorized For Canonical Use",
      "type": "boolean"
    },
    "not_authorized_for_budget_logic": {
      "default": true,
      "title": "Not Authorized For Budget Logic",
      "type": "boolean"
    },
    "not_authorized_for_rejection_logic": {
      "default": true,
      "title": "Not Authorized For Rejection Logic",
      "type": "boolean"
    }
  },
  "required": [
    "report_id",
    "generated_at",
    "status",
    "acceptance_gate_status",
    "crosswalk_count",
    "entry_count",
    "mapped_entry_count",
    "unmapped_entry_count",
    "canonical_claim_count",
    "candidate_only_violation_count",
    "entries_missing_provenance_count",
    "entries_missing_review_status_count",
    "guessed_mapping_count",
    "prohibited_actions"
  ],
  "title": "CrosswalkAuditReport",
  "type": "object"
}
