    "projection_total_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Projection Total Delta"
    },
    "rule_count": {
      "minimum": 0,
      "title": "Rule Count",
      "type": "integer"
    },
    "impact_line_count": {
      "minimum": 0,
      "title": "Impact Line Count",
      "type": "integer"
    },
    "candidate_rule_id_count": {
      "minimum": 0,
      "title": "Candidate Rule Id Count",
      "type": "integer"
    },
    "canonical_rule_id_violation_count": {
      "minimum": 0,
      "title": "Canonical Rule Id Violation Count",
      "type": "integer"
    },
    "source_owner_violation_count": {
      "minimum": 0,
      "title": "Source Owner Violation Count",
      "type": "integer"
    },
    "read_only_violation_count": {
      "minimum": 0,
      "title": "Read Only Violation Count",
      "type": "integer"
    },
    "rewrite_budget_violation_count": {
      "minimum": 0,
      "title": "Rewrite Budget Violation Count",
      "type": "integer"
    },
    "real_guideline_or_rate_violation_count": {
      "minimum": 0,
      "title": "Real Guideline Or Rate Violation Count",
      "type": "integer"
    },
    "budget_projection_mismatch_count": {
      "minimum": 0,
      "title": "Budget Projection Mismatch Count",
      "type": "integer"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/OCGRuleIRAdoptionFinding"
      },
      "title": "Findings",
      "type": "array"
    },
    "impact_lines": {
      "items": {
        "$ref": "#/$defs/OCGRuleImpactLine"
      },
      "title": "Impact Lines",
      "type": "array"
    },
    "display_banner": {
      "additionalProperties": true,
      "title": "Display Banner",
      "type": "object"
    },
    "prohibited_actions": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Actions",
      "type": "array"
    },
    "proposed_budget_preserved": {
      "default": true,
      "title": "Proposed Budget Preserved",
      "type": "boolean"
    },
    "projection_rewrites_budget": {
      "default": false,
      "title": "Projection Rewrites Budget",
      "type": "boolean"
    },
    "read_only_consumption": {
      "default": true,
      "title": "Read Only Consumption",
      "type": "boolean"
    },
    "candidate_only": {
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "not_promoted_canon": {
      "default": true,
      "title": "Not Promoted Canon",
      "type": "boolean"
    },
    "not_authorized_for_canonical_use": {
      "default": true,
      "title": "Not Authorized For Canonical Use",
      "type": "boolean"
    },
    "not_authorized_for_budget_rewrite": {
      "default": true,
      "title": "Not Authorized For Budget Rewrite",
      "type": "boolean"
    },
    "not_authorized_for_client_submission": {
      "default": true,
      "title": "Not Authorized For Client Submission",
      "type": "boolean"
    },
    "not_authorized_for_external_submission": {
      "default": true,
      "title": "Not Authorized For External Submission",
      "type": "boolean"
    },
    "not_authorized_for_lake_write": {
      "default": true,
      "title": "Not Authorized For Lake Write",
      "type": "boolean"
    }
