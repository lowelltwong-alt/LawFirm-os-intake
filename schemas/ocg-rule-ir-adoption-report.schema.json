{
  "$defs": {
    "OCGRuleIRAdoptionFinding": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "severity": {
          "enum": [
            "blocker",
            "warning"
          ],
          "title": "Severity",
          "type": "string"
        },
        "issue": {
          "title": "Issue",
          "type": "string"
        },
        "rule_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule Id"
        }
      },
      "required": [
        "finding_id",
        "severity",
        "issue"
      ],
      "title": "OCGRuleIRAdoptionFinding",
      "type": "object"
    },
    "OCGRuleImpactLine": {
      "additionalProperties": false,
      "properties": {
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "rule_family": {
          "title": "Rule Family",
          "type": "string"
        },
        "impact_bucket": {
          "title": "Impact Bucket",
          "type": "string"
        },
        "matched_projection_refs": {
          "items": {
            "type": "string"
          },
          "title": "Matched Projection Refs",
          "type": "array"
        },
        "proposed_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Amount"
        },
        "compliant_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compliant Amount"
        },
        "delta_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delta Amount"
        },
        "note": {
          "title": "Note",
          "type": "string"
        },
        "candidate_only": {
          "default": true,
          "title": "Candidate Only",
          "type": "boolean"
        }
      },
      "required": [
        "rule_id",
        "rule_family",
        "impact_bucket",
        "note"
      ],
      "title": "OCGRuleImpactLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
