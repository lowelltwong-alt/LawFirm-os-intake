{
  "$defs": {
    "BudgetPreconditionCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "BudgetPreconditionCheck",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "budget_precondition_report_id": {
      "title": "Budget Precondition Report Id",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "preflight_packet_id": {
      "title": "Preflight Packet Id",
      "type": "string"
    },
    "confirmation_id": {
      "title": "Confirmation Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "passed",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/BudgetPreconditionCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "blocked_state": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Blocked State"
    },
    "input_refs": {
      "items": {
        "type": "string"
      },
      "title": "Input Refs",
      "type": "array"
    },
    "human_review_outcome_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Human Review Outcome Ref"
    },
    "labor_employment_budget_fact_report_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Labor Employment Budget Fact Report Ref"
    },
    "labor_employment_budget_readiness_state": {
      "anyOf": [
        {
          "enum": [
            "blocked_missing_critical_facts",
            "range_only_pending_human_review",
            "candidate_ready_for_budget_review"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Labor Employment Budget Readiness State"
    },
    "labor_employment_budget_treatment": {
      "default": "not_applicable",
      "enum": [
        "not_applicable",
        "block_amount_budget",
        "hours_only_or_broad_range",
        "candidate_range_budget_after_review",
        "candidate_ready_for_budget_review"
      ],
      "title": "Labor Employment Budget Treatment",
      "type": "string"
    },
    "labor_employment_critical_gap_count": {
      "default": 0,
      "minimum": 0,
      "title": "Labor Employment Critical Gap Count",
      "type": "integer"
    },
    "labor_employment_required_human_questions": {
      "items": {
        "type": "string"
      },
      "title": "Labor Employment Required Human Questions",
      "type": "array"
    },
    "labor_employment_driver_impact_report_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Labor Employment Driver Impact Report Ref"
    },
    "labor_employment_driver_impact_status": {
      "anyOf": [
        {
          "enum": [
            "labor_employment_executable_driver_impacts_ready_for_review",
            "blocked_by_labor_employment_executable_driver_impacts"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Labor Employment Driver Impact Status"
    },
    "labor_employment_driver_allowed_budget_output": {
      "anyOf": [
        {
          "enum": [
            "blocked_amount_budget",
            "range_or_hours_only_pending_review",
            "candidate_range_after_review_pending_human_review"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Labor Employment Driver Allowed Budget Output"
    },
    "labor_employment_driver_block_amount_budget_impact_count": {
      "default": 0,
      "minimum": 0,
      "title": "Labor Employment Driver Block Amount Budget Impact Count",
      "type": "integer"
    },
    "labor_employment_driver_range_widening_impact_count": {
      "default": 0,
      "minimum": 0,
      "title": "Labor Employment Driver Range Widening Impact Count",
      "type": "integer"
    },
    "labor_employment_driver_scenario_fork_impact_count": {
      "default": 0,
      "minimum": 0,
      "title": "Labor Employment Driver Scenario Fork Impact Count",
      "type": "integer"
    },
    "labor_employment_driver_rate_guideline_review_impact_count": {
      "default": 0,
      "minimum": 0,
      "title": "Labor Employment Driver Rate Guideline Review Impact Count",
      "type": "integer"
    },
    "labor_employment_driver_max_range_widening_factor": {
      "default": 1.0,
      "minimum": 1.0,
      "title": "Labor Employment Driver Max Range Widening Factor",
      "type": "number"
    },
    "prohibited_outputs": {
      "items": {
        "type": "string"
      },
      "title": "Prohibited Outputs",
      "type": "array"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "budget_precondition_report_id",
    "run_id",
    "preflight_packet_id",
    "confirmation_id",
    "status",
    "checks",
    "input_refs",
    "prohibited_outputs",
    "generated_at"
  ],
  "title": "BudgetPreconditionReport",
  "type": "object"
}
