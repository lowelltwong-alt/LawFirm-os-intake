{
  "$defs": {
    "EntityComparisonResult": {
      "additionalProperties": false,
      "properties": {
        "left": {
          "$ref": "#/$defs/EntityNormalizationResult"
        },
        "right": {
          "$ref": "#/$defs/EntityNormalizationResult"
        },
        "comparison_rung": {
          "enum": [
            "E1_exact",
            "E2_normalized_exact",
            "E3_declared_alias",
            "E4_declared_structure",
            "E5_suffix_residual",
            "E6_no_match"
          ],
          "title": "Comparison Rung",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "match",
            "related",
            "hold",
            "no_match"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "disposition": {
          "enum": [
            "raw_exact",
            "normalized_exact",
            "declared_alias",
            "related_distinct",
            "unreviewed_structure_edge",
            "suffix_conflict",
            "possible_affiliate",
            "no_match"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "decision_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Decision Rule Ids",
          "type": "array"
        },
        "review_required": {
          "title": "Review Required",
          "type": "boolean"
        },
        "alias_proposal_required": {
          "title": "Alias Proposal Required",
          "type": "boolean"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "left",
        "right",
        "comparison_rung",
        "outcome",
        "disposition",
        "decision_rule_ids",
        "review_required",
        "alias_proposal_required"
      ],
      "title": "EntityComparisonResult",
      "type": "object"
    },
    "EntityNormalizationResult": {
      "additionalProperties": false,
      "properties": {
        "raw_value": {
          "title": "Raw Value",
          "type": "string"
        },
        "normalized_value": {
          "title": "Normalized Value",
          "type": "string"
        },
        "base_value": {
          "title": "Base Value",
          "type": "string"
        },
        "suffix_stripped": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Suffix Stripped"
        },
        "rewrites_applied": {
          "items": {
            "type": "string"
          },
          "title": "Rewrites Applied",
          "type": "array"
        },
        "residual_terms_stripped": {
          "items": {
            "type": "string"
          },
          "title": "Residual Terms Stripped",
          "type": "array"
        },
        "normalization_rule_ids": {
          "items": {
            "type": "string"
          },
          "title": "Normalization Rule Ids",
          "type": "array"
        },
        "status": {
          "const": "candidate",
          "default": "candidate",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "raw_value",
        "normalized_value",
        "base_value",
        "normalization_rule_ids"
      ],
      "title": "EntityNormalizationResult",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "segment_id": {
          "title": "Segment Id",
          "type": "string"
        },
        "start_offset": {
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "title": "End Offset",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "segment_id",
        "start_offset",
        "end_offset",
        "sha256"
      ],
      "title": "EvidenceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "correction_id": {
      "title": "Correction Id",
      "type": "string"
    },
    "comparison": {
      "$ref": "#/$defs/EntityComparisonResult"
    },
    "left_evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Left Evidence Refs",
      "type": "array"
    },
    "right_evidence_refs": {
      "items": {
        "$ref": "#/$defs/EvidenceRef"
      },
      "title": "Right Evidence Refs",
      "type": "array"
    },
    "outcome": {
      "enum": [
        "confirm_alias_table_candidate",
        "confirm_related_distinct",
        "confirm_no_match",
        "needs_more_information",
        "correct_declared_edge"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "decision_reason": {
      "title": "Decision Reason",
      "type": "string"
    },
    "reviewer_id": {
      "title": "Reviewer Id",
      "type": "string"
    },
    "reviewed_at": {
      "title": "Reviewed At",
      "type": "string"
    },
    "proposed_local_table_change": {
      "default": "none",
      "enum": [
        "none",
        "alias_edge",
        "structure_edge"
      ],
      "title": "Proposed Local Table Change",
      "type": "string"
    },
    "supersedes_correction_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes Correction Id"
    },
    "red_team_notes": {
      "items": {
        "type": "string"
      },
      "title": "Red Team Notes",
      "type": "array"
    }
  },
  "required": [
    "correction_id",
    "comparison",
    "left_evidence_refs",
    "right_evidence_refs",
    "outcome",
    "decision_reason",
    "reviewer_id",
    "reviewed_at",
    "red_team_notes"
  ],
  "title": "EntityResolutionCorrectionDecision",
  "type": "object"
}
