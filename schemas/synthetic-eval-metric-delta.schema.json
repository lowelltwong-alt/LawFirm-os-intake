{
  "additionalProperties": false,
  "description": "A single-axis metric delta between two capture-ledger entries.",
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "from_entry_id": {
      "title": "From Entry Id",
      "type": "string"
    },
    "to_entry_id": {
      "title": "To Entry Id",
      "type": "string"
    },
    "changed_axis": {
      "enum": [
        "corpus_seed",
        "corpus_digest",
        "generator_version",
        "eval_version",
        "code_ref"
      ],
      "title": "Changed Axis",
      "type": "string"
    },
    "comparability": {
      "enum": [
        "comparable",
        "not_comparable"
      ],
      "title": "Comparability",
      "type": "string"
    },
    "routing_accuracy_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Routing Accuracy Delta"
    },
    "abstention_recall_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstention Recall Delta"
    },
    "budget_plausibility_delta": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Plausibility Delta"
    },
    "regression_flags": {
      "items": {
        "type": "string"
      },
      "title": "Regression Flags",
      "type": "array"
    },
    "status": {
      "enum": [
        "improved",
        "unchanged",
        "metric_regression_requires_review",
        "not_comparable"
      ],
      "title": "Status",
      "type": "string"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    }
  },
  "required": [
    "from_entry_id",
    "to_entry_id",
    "changed_axis",
    "comparability",
    "status"
  ],
  "title": "SyntheticEvalMetricDelta",
  "type": "object"
}
