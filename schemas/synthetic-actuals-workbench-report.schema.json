        "variance_driver_candidates": {
          "items": {
            "$ref": "#/$defs/BudgetActualVarianceDriverCandidate"
          },
          "title": "Variance Driver Candidates",
          "type": "array"
        },
        "learning_disposition_candidates": {
          "items": {
            "type": "string"
          },
          "title": "Learning Disposition Candidates",
          "type": "array"
        },
        "variance_threshold_percent": {
          "minimum": 0,
          "title": "Variance Threshold Percent",
          "type": "number"
        },
        "total_budgeted": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Budgeted"
        },
        "total_actual": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Actual"
        },
        "total_variance_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Variance Amount"
        },
        "total_variance_percent": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Variance Percent"
        },
        "actuals_source_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
