    "manifest_ref",
    "manifest_id",
    "policy_ref",
    "primary_practice_area",
    "budget_readiness_state",
    "finding_count",
    "source_bound_finding_count",
    "needs_review_finding_count",
    "unknown_finding_count",
    "gap_count",
    "critical_gap_count",
    "findings",
    "gaps",
    "required_human_questions",
    "checks",
