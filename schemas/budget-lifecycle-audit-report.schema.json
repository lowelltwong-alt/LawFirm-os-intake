{
  "$defs": {
    "BudgetLifecycleAuditCheck": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "warning"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "artifact_refs": {
          "items": {
            "type": "string"
          },
          "title": "Artifact Refs",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "BudgetLifecycleAuditCheck",
      "type": "object"
    },
    "BudgetLifecycleFinancialSummary": {
      "additionalProperties": false,
      "properties": {
        "original_budget_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Original Budget Total"
        },
        "human_revision_total_delta": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Revision Total Delta"
        },
        "human_revised_candidate_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Human Revised Candidate Total"
        },
        "actual_comparison_budgeted_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Comparison Budgeted Total"
        },
        "actual_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Total"
        },
        "actual_variance_amount": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Variance Amount"
        },
        "carrier_disputed_amount": {
          "default": 0,
          "minimum": 0,
          "title": "Carrier Disputed Amount",
          "type": "number"
        },
        "carrier_recovered_amount": {
          "default": 0,
          "minimum": 0,
          "title": "Carrier Recovered Amount",
          "type": "number"
        },
        "carrier_write_down_amount": {
          "default": 0,
          "minimum": 0,
          "title": "Carrier Write Down Amount",
          "type": "number"
        }
      },
      "title": "BudgetLifecycleFinancialSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "lifecycle_audit_report_id": {
      "title": "Lifecycle Audit Report Id",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready_for_budget_lifecycle_review",
        "blocked_missing_lifecycle_artifacts",
        "blocked_inconsistent_lifecycle_evidence"
      ],
      "title": "Status",
      "type": "string"
    },
    "budget_proposal_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Proposal Id"
    },
    "preflight_packet_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preflight Packet Id"
    },
    "run_ids": {
      "items": {
        "type": "string"
      },
      "title": "Run Ids",
      "type": "array"
    },
    "source_budget_change_ledger_report_ref": {
      "title": "Source Budget Change Ledger Report Ref",
      "type": "string"
    },
    "source_budget_actual_variance_ledger_report_ref": {
      "title": "Source Budget Actual Variance Ledger Report Ref",
      "type": "string"
    },
    "source_carrier_rejection_decision_ledger_report_ref": {
      "title": "Source Carrier Rejection Decision Ledger Report Ref",
      "type": "string"
    },
    "source_budget_event_lake_bundle_report_ref": {
      "title": "Source Budget Event Lake Bundle Report Ref",
      "type": "string"
    },
    "budget_change_ledger_report_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Change Ledger Report Id"
    },
    "budget_actual_variance_ledger_report_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Actual Variance Ledger Report Id"
    },
    "carrier_rejection_decision_ledger_report_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Carrier Rejection Decision Ledger Report Id"
    },
    "budget_event_lake_bundle_report_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Budget Event Lake Bundle Report Id"
    },
    "budget_change_event_count": {
      "minimum": 0,
      "title": "Budget Change Event Count",
      "type": "integer"
    },
    "actual_variance_event_count": {
      "minimum": 0,
      "title": "Actual Variance Event Count",
      "type": "integer"
    },
    "carrier_rejection_event_count": {
      "minimum": 0,
      "title": "Carrier Rejection Event Count",
      "type": "integer"
    },
    "total_lifecycle_event_count": {
      "minimum": 0,
      "title": "Total Lifecycle Event Count",
      "type": "integer"
    },
    "human_budget_change_event_count": {
      "minimum": 0,
      "title": "Human Budget Change Event Count",
      "type": "integer"
    },
    "actual_variance_review_event_count": {
      "minimum": 0,
      "title": "Actual Variance Review Event Count",
      "type": "integer"
    },
    "carrier_pending_decision_event_count": {
      "minimum": 0,
      "title": "Carrier Pending Decision Event Count",
      "type": "integer"
    },
    "carrier_appeal_result_event_count": {
      "minimum": 0,
      "title": "Carrier Appeal Result Event Count",
      "type": "integer"
    },
    "carrier_financial_outcome_event_count": {
      "minimum": 0,
      "title": "Carrier Financial Outcome Event Count",
      "type": "integer"
    },
    "pending_human_decision_count": {
      "minimum": 0,
      "title": "Pending Human Decision Count",
      "type": "integer"
    },
    "required_human_decisions": {
      "items": {
        "type": "string"
      },
      "title": "Required Human Decisions",
      "type": "array"
    },
    "proposed_next_actions": {
      "items": {
        "type": "string"
      },
      "title": "Proposed Next Actions",
      "type": "array"
    },
    "candidate_record_families": {
      "items": {
        "enum": [
          "budget_human_change_record",
          "budget_actual_variance_record",
          "budget_actual_missing_source_record",
          "carrier_rejection_decision_record",
          "carrier_appeal_result_record",
          "carrier_financial_outcome_record"
        ],
        "type": "string"
      },
      "title": "Candidate Record Families",
      "type": "array"
    },
    "local_event_labels": {
      "items": {
        "type": "string"
      },
      "title": "Local Event Labels",
      "type": "array"
    },
    "financial_summary": {
      "$ref": "#/$defs/BudgetLifecycleFinancialSummary"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/BudgetLifecycleAuditCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "required_next_gates": {
      "items": {
        "type": "string"
      },
      "title": "Required Next Gates",
      "type": "array"
    },
    "candidate_only": {
      "const": true,
      "default": true,
      "title": "Candidate Only",
      "type": "boolean"
    },
    "non_authoritative": {
      "const": true,
      "default": true,
      "title": "Non Authoritative",
      "type": "boolean"
    },
    "synthetic_only": {
      "const": true,
      "default": true,
      "title": "Synthetic Only",
      "type": "boolean"
    },
    "append_only_evidence_required": {
      "const": true,
      "default": true,
      "title": "Append Only Evidence Required",
      "type": "boolean"
    },
    "human_review_required": {
      "const": true,
      "default": true,
      "title": "Human Review Required",
      "type": "boolean"
    },
    "orchestrator_owner_for_runtime_capture": {
      "const": true,
      "default": true,
      "title": "Orchestrator Owner For Runtime Capture",
      "type": "boolean"
    },
    "exception_lake_owner_for_admission": {
      "const": true,
      "default": true,
      "title": "Exception Lake Owner For Admission",
      "type": "boolean"
    },
    "no_connector_implemented": {
      "const": true,
      "default": true,
      "title": "No Connector Implemented",
      "type": "boolean"
    },
    "no_lake_admission_performed": {
      "const": true,
      "default": true,
      "title": "No Lake Admission Performed",
      "type": "boolean"
    },
    "no_sibling_repo_writes": {
      "const": true,
      "default": true,
      "title": "No Sibling Repo Writes",
      "type": "boolean"
    },
    "no_canonical_mutation": {
      "const": true,
      "default": true,
      "title": "No Canonical Mutation",
      "type": "boolean"
    },
    "not_authorized_for_lake_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Lake Write",
      "type": "boolean"
    },
    "not_authorized_for_sqlite_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Sqlite Write",
      "type": "boolean"
    },
    "not_authorized_for_external_write": {
      "const": true,
      "default": true,
      "title": "Not Authorized For External Write",
      "type": "boolean"
    },
    "not_authorized_for_budget_submission": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Budget Submission",
      "type": "boolean"
    },
    "not_authorized_for_carrier_submission": {
      "const": true,
      "default": true,
      "title": "Not Authorized For Carrier Submission",
      "type": "boolean"
    },
    "lake_write_performed": {
      "const": false,
      "default": false,
      "title": "Lake Write Performed",
      "type": "boolean"
    },
    "sqlite_write_performed": {
      "const": false,
      "default": false,
      "title": "Sqlite Write Performed",
      "type": "boolean"
    },
    "external_writes_performed": {
      "const": false,
      "default": false,
      "title": "External Writes Performed",
      "type": "boolean"
    },
    "billing_connector_read_performed": {
      "const": false,
      "default": false,
      "title": "Billing Connector Read Performed",
      "type": "boolean"
    },
    "billing_connector_write_performed": {
      "const": false,
      "default": false,
      "title": "Billing Connector Write Performed",
      "type": "boolean"
    },
    "carrier_portal_write_performed": {
      "const": false,
      "default": false,
      "title": "Carrier Portal Write Performed",
      "type": "boolean"
    },
    "email_send_performed": {
      "const": false,
      "default": false,
      "title": "Email Send Performed",
      "type": "boolean"
    },
    "appeal_submission_performed": {
      "const": false,
      "default": false,
      "title": "Appeal Submission Performed",
      "type": "boolean"
    },
    "budget_submission_performed": {
      "const": false,
      "default": false,
      "title": "Budget Submission Performed",
      "type": "boolean"
    },
    "budget_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Budget Mutation Performed",
      "type": "boolean"
    },
    "profile_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Profile Mutation Performed",
      "type": "boolean"
    },
    "template_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Template Mutation Performed",
      "type": "boolean"
    },
    "carrier_guideline_mutation_performed": {
      "const": false,
      "default": false,
      "title": "Carrier Guideline Mutation Performed",
      "type": "boolean"
    },
    "silent_learning_performed": {
      "const": false,
      "default": false,
      "title": "Silent Learning Performed",
      "type": "boolean"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    }
  },
  "required": [
    "lifecycle_audit_report_id",
    "status",
    "source_budget_change_ledger_report_ref",
    "source_budget_actual_variance_ledger_report_ref",
    "source_carrier_rejection_decision_ledger_report_ref",
    "source_budget_event_lake_bundle_report_ref",
    "budget_change_event_count",
    "actual_variance_event_count",
    "carrier_rejection_event_count",
    "total_lifecycle_event_count",
    "human_budget_change_event_count",
    "actual_variance_review_event_count",
    "carrier_pending_decision_event_count",
    "carrier_appeal_result_event_count",
    "carrier_financial_outcome_event_count",
    "pending_human_decision_count",
    "financial_summary",
    "checks",
    "required_next_gates",
    "generated_at"
  ],
  "title": "BudgetLifecycleAuditReport",
  "type": "object"
}
