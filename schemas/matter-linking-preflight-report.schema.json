          "type": "integer"
        },
        "strong_supporting_signal_count": {
          "minimum": 0,
          "title": "Strong Supporting Signal Count",
          "type": "integer"
        },
        "negative_signal_count": {
          "minimum": 0,
          "title": "Negative Signal Count",
          "type": "integer"
