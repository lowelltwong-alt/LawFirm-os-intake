      "additionalProperties": false,
      "properties": {
        "check_id": {
          "title": "Check Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "blocking_refs": {
          "items": {
            "type": "string"
          },
          "title": "Blocking Refs",
          "type": "array"
        }
      },
      "required": [
        "check_id",
        "status",
        "message"
      ],
      "title": "MatterLinkingPreflightCheck",
      "type": "object"
    },
    "MatterLinkingPreflightCluster": {
