      "type": "integer"
    },
    "decision_count": {
      "minimum": 0,
      "title": "Decision Count",
      "type": "integer"
    },
    "cluster_count": {
      "minimum": 0,
      "title": "Cluster Count",
      "type": "integer"
    },
    "conflicted_cluster_count": {
      "minimum": 0,
      "title": "Conflicted Cluster Count",
      "type": "integer"
    },
    "hold_cluster_count": {
      "minimum": 0,
      "title": "Hold Cluster Count",
      "type": "integer"
    },
    "proposed_link_cluster_count": {
      "minimum": 0,
      "title": "Proposed Link Cluster Count",
      "type": "integer"
    },
    "decisions": {
      "items": {
        "$ref": "#/$defs/MatterLinkDecisionRecord"
