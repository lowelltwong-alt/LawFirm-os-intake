    "matter_opening_authorized": {
      "const": false,
      "default": false,
      "title": "Matter Opening Authorized",
      "type": "boolean"
    },
    "connector_called": {
      "const": false,
      "default": false,
      "title": "Connector Called",
      "type": "boolean"
